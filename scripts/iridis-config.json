{
  "input": {
    "colors": ["#08717A", "#24A5B5", "#7FE7D8"],
    "contrast": { "level": "AAA", "algorithm": "wcag21" },
    "metadata": {
      "cssVarPrefix": "--jt-",
      "themeName": "json-tology"
    },
    "roles": {
      "name": "json-tology-docs-aaa",
      "description": "WCAG 2.1 AAA palette for the json-tology docs site (light + dark)",
      "roles": [
        {
          "name":           "canvas",
          "description":    "Page background",
          "intent":         "background",
          "required":       true,
          "lightnessRange": [0.98, 1.0]
        },
        {
          "name":           "surface",
          "description":    "Elevated surface (sidebar, cards)",
          "intent":         "background",
          "required":       true,
          "lightnessRange": [0.96, 0.99]
        },
        {
          "name":           "surfaceSoft",
          "description":    "Subtle tinted surface for inline highlights",
          "intent":         "background",
          "required":       true,
          "lightnessRange": [0.95, 0.985]
        },
        {
          "name":           "text",
          "description":    "Primary body text",
          "intent":         "text",
          "required":       true,
          "lightnessRange": [0.08, 0.20]
        },
        {
          "name":           "textMuted",
          "description":    "Secondary text",
          "intent":         "muted",
          "required":       true,
          "lightnessRange": [0.25, 0.40]
        },
        {
          "name":           "textSubtle",
          "description":    "Tertiary text / captions / timestamps",
          "intent":         "muted",
          "required":       true,
          "lightnessRange": [0.38, 0.52]
        },
        {
          "name":           "accent",
          "description":    "JST teal — links, primary actions, headings",
          "intent":         "accent",
          "required":       true,
          "lightnessRange": [0.28, 0.42]
        },
        {
          "name":           "accentHover",
          "description":    "Darker accent for hover state",
          "intent":         "accent",
          "required":       true,
          "lightnessRange": [0.20, 0.34]
        },
        {
          "name":           "accentUi",
          "description":    "Brighter accent for UI components and large text",
          "intent":         "accent",
          "required":       true,
          "lightnessRange": [0.42, 0.58]
        },
        {
          "name":           "onAccent",
          "description":    "Text placed on the accent color",
          "intent":         "text",
          "required":       true,
          "lightnessRange": [0.96, 1.0]
        },
        {
          "name":           "border",
          "description":    "Component borders and dividers",
          "intent":         "muted",
          "required":       true,
          "lightnessRange": [0.45, 0.65]
        }
      ],
      "contrastPairs": [
        { "foreground": "text",        "background": "canvas",      "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "text",        "background": "surface",     "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "text",        "background": "surfaceSoft", "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "textMuted",   "background": "canvas",      "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "textMuted",   "background": "surface",     "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "textSubtle",  "background": "canvas",      "minRatio": 4.5, "algorithm": "wcag21" },
        { "foreground": "accent",      "background": "canvas",      "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "accent",      "background": "surface",     "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "accent",      "background": "surfaceSoft", "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "accentHover", "background": "canvas",      "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "accentUi",    "background": "canvas",      "minRatio": 4.5, "algorithm": "wcag21" },
        { "foreground": "onAccent",    "background": "accent",      "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "onAccent",    "background": "accentHover", "minRatio": 7.0, "algorithm": "wcag21" },
        { "foreground": "border",      "background": "canvas",      "minRatio": 4.5, "algorithm": "wcag21" }
      ]
    }
  },
  "enableContrast":   true,
  "enableStylesheet": true,
  "pipeline": [
    "intake:any",
    "expand:family",
    "resolve:roles",
    "enforce:wcagAAA",
    "derive:variant",
    "emit:cssVars"
  ],
  "output": {
    "directory": "./scripts/iridis-out",
    "files": {
      "cssVars": "json-tology-palette.json"
    }
  }
}

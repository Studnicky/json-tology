{
  "name": "json-tology",
  "version": "0.27.0",
  "description": "One source of truth for TypeScript types, runtime validation, coercion, and OWL ontology output. Author in JSON Schema; share with any backend; reason over the graph.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "json-tology": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./value": {
      "import": "./dist/value/index.js",
      "types": "./dist/value/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    },
    "./ontology": {
      "import": "./dist/ontology/index.js",
      "types": "./dist/ontology/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./interfaces": {
      "import": "./dist/interfaces/index.js",
      "types": "./dist/interfaces/index.d.ts"
    },
    "./owl-gen": {
      "import": "./dist/owl-gen/index.js",
      "types": "./dist/owl-gen/index.d.ts"
    },
    "./owl-gen-node": {
      "import": "./dist/owl-gen-node/index.js",
      "types": "./dist/owl-gen-node/index.d.ts"
    },
    "./viz": {
      "import": "./dist/viz/index.js",
      "types": "./dist/viz/index.d.ts"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "ensure-built": "node ./scripts/ensure-built.mjs",
    "type-check": "tsc --noEmit",
    "type-check:examples": "tsc --noEmit -p tsconfig.examples.json",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "type-check:tests:all": "tsc --noEmit -p tsconfig.tests.json",
    "type-check:all": "npm run type-check && npm run type-check:examples && npm run type-check:tests:all && npm run test:decl",
    "test:decl": "tsc -p tsconfig.decl-emit.json && rm -rf dist-decl-emit-test",
    "pretest": "npm run ensure-built",
    "test": "tsx --test --test-concurrency=4 'test/smoke/**/*.test.ts' 'test/unit/**/*.test.ts'",
    "pretest:smoke": "npm run ensure-built",
    "test:smoke": "tsx --test --test-concurrency=4 'test/smoke/**/*.test.ts'",
    "test:unit": "tsx --test --test-concurrency=4 'test/unit/**/*.test.ts'",
    "test:integration": "tsx --test --test-concurrency=4 'test/integration/**/*.test.ts'",
    "pretest:e2e": "npm run ensure-built",
    "test:e2e": "tsx --test --test-concurrency=4 'test/e2e/**/*.test.ts'",
    "test:types": "tsx --test --test-concurrency=4 'test/types/**/*.test.ts'",
    "pretest:all": "npm run ensure-built",
    "test:all": "tsx --test --test-concurrency=4 'test/smoke/**/*.test.ts' 'test/unit/**/*.test.ts' 'test/integration/**/*.test.ts' 'test/e2e/**/*.test.ts' 'test/types/**/*.test.ts'",
    "test:coverage": "tsx --test --test-concurrency=4 --experimental-test-coverage 'test/smoke/**/*.test.ts' 'test/unit/**/*.test.ts'",
    "regen:ontology-fixtures": "node ./scripts/regen-ontology-fixtures.mjs",
    "build:bookstore-tbox": "node ./scripts/build-bookstore-tbox.mjs",
    "build:bookstore-tbox:check": "node ./scripts/build-bookstore-tbox.mjs --check",
    "build:palette": "node ./scripts/build-palette.mjs",
    "pack:check": "node ./scripts/check-pack.mjs",
    "stamp-version": "node ./scripts/stamp-version.mjs",
    "stamp-version:check": "node ./scripts/stamp-version.mjs --check",
    "predocs:build": "npm run stamp-version",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run build:bookstore-tbox && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check-includes": "node ./scripts/check-docs-includes.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "bench": "tsx examples/docs/benchmarks/run.ts",
    "bench:report": "tsx examples/docs/benchmarks/run.ts --report",
    "bench:flame": "node --cpu-prof --cpu-prof-dir=.flame --cpu-prof-name=flame.cpuprofile --import tsx/esm examples/docs/benchmarks/run.ts"
  },
  "keywords": [
    "coercion",
    "json-ld",
    "json-schema",
    "ontology",
    "owl",
    "rdf",
    "semantic-web",
    "shacl",
    "type-inference",
    "type-system",
    "validation"
  ],
  "author": "Studnicky (https://github.com/Studnicky)",
  "license": "MIT",
  "homepage": "https://studnicky.github.io/json-tology/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/json-tology.git"
  },
  "bugs": {
    "url": "https://github.com/Studnicky/json-tology/issues"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@eslint/js": "^10.0.1",
    "@sinclair/typebox": "^0.34.50",
    "@studnicky/eslint-config": "^5.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/json-schema": "^7.0.15",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.33.4",
    "cytoscape-fcose": "^2.2.0",
    "eslint": "^10.4.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unicorn": "^66.0.0",
    "eslint-plugin-yml": "^3.3.2",
    "eyereasoner": "^21.1.13",
    "fp-ts": "^2.16.11",
    "globals": "^17.7.0",
    "io-ts": "^2.2.22",
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "n3": "^2.1.1",
    "sucrase": "^3.35.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "valibot": "^1.4.2",
    "vitepress": "^1.6.4",
    "vitepress-sidebar": "^1.36.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "commander": "^15.0.0",
    "jsonld": "^9.0.0"
  },
  "peerDependencies": {
    "eyereasoner": "^21.1.13"
  },
  "peerDependenciesMeta": {
    "eyereasoner": {
      "optional": true
    }
  },
  "overrides": {
    "undici": "^6.27.0",
    "js-yaml": "^3.15.0",
    "esbuild": "^0.25.0",
    "vite": "^6.4.3"
  },
  "json-tology": {
    "seo": {
      "googleSiteVerification": "",
      "bingSiteVerification": "",
      "twitterHandle": ""
    }
  }
}

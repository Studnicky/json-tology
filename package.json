{
  "name": "json-tology",
  "version": "0.1.0",
  "description": "Graph-native JSON Schema type system with JSON-LD ontology support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "json-tology": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./value": {
      "import": "./dist/value.js",
      "types": "./dist/value.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./ontology": {
      "import": "./dist/ontology.js",
      "types": "./dist/ontology.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./interfaces": {
      "import": "./dist/interfaces/index.js",
      "types": "./dist/interfaces/index.d.ts"
    },
    "./viz": {
      "import": "./dist/viz.js",
      "types": "./dist/viz.d.ts"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "type-check": "tsc --noEmit",
    "test": "tsx --test 'test/unit/**/*.test.ts'",
    "test:coverage": "tsx --test --experimental-test-coverage 'test/unit/**/*.test.ts'",
    "pack:check": "node ./scripts/check-pack.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "bench": "tsx bench/run.ts",
    "bench:flame": "0x --output-dir .flame -- node --import tsx/esm bench/run.ts"
  },
  "keywords": [
    "json-schema",
    "validation",
    "type-system",
    "ontology",
    "semantic-web",
    "rdf",
    "jsonld"
  ],
  "author": "Studnicky (https://github.com/Studnicky)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rdfjs/types": "^2.0.1",
    "@sinclair/typebox": "^0.34.48",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/json-schema": "^7.0.15",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "0x": "^6.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-yml": "^3.3.1",
    "eyereasoner": "^21.0.4",
    "globals": "^17.4.0",
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "n3": "^2.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

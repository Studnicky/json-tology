{
  "name": "json-tology",
  "version": "0.1.0",
  "description": "JSON-Schema type system + ontology builder for TypeScript projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    },
    "./ontology": {
      "import": "./dist/ontology/index.js",
      "types": "./dist/ontology/index.d.ts"
    },
    "./interfaces": {
      "import": "./dist/interfaces/index.js",
      "types": "./dist/interfaces/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "tsx --test 'test/unit/**/*.test.ts'",
    "clean": "rm -rf dist",
    "bench": "tsx bench/run.ts",
    "bench:flame": "0x --output-dir .flame -- node --import tsx/esm bench/run.ts"
  },
  "keywords": [
    "json-schema",
    "validation",
    "type-system",
    "ontology",
    "semantic-web",
    "rdf",
    "jsonld"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-ts": "^3.1.1"
  },
  "devDependencies": {
    "@apacenai/dev-tools": "file:vendor/dev-tools",
    "@eslint/js": "^10.0.1",
    "@sinclair/typebox": "^0.34.48",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "0x": "^6.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-filename-export": "^2.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-yml": "^3.3.1",
    "globals": "^17.4.0",
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "n3": "^2.0.3",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

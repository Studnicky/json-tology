{
  "name": "json-tology",
  "version": "0.3.3",
  "description": "One source of truth for TypeScript types, runtime validation, coercion, and OWL ontology output. Author in JSON Schema; share with any backend; reason over the graph.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "json-tology": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./value": {
      "import": "./dist/value.js",
      "types": "./dist/value.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./ontology": {
      "import": "./dist/ontology.js",
      "types": "./dist/ontology.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./interfaces": {
      "import": "./dist/interfaces/index.js",
      "types": "./dist/interfaces/index.d.ts"
    },
    "./viz": {
      "import": "./dist/viz.js",
      "types": "./dist/viz.d.ts"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "type-check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 'test/smoke/**/*.test.ts' 'test/unit/**/*.test.ts'",
    "test:smoke": "tsx --test --test-concurrency=4 'test/smoke/**/*.test.ts'",
    "test:unit": "tsx --test --test-concurrency=4 'test/unit/**/*.test.ts'",
    "test:integration": "tsx --test --test-concurrency=4 'test/integration/**/*.test.ts'",
    "test:e2e": "tsx --test --test-concurrency=4 'test/e2e/**/*.test.ts'",
    "test:types": "tsx --test --test-concurrency=4 'test/types/**/*.test.ts'",
    "test:all": "tsx --test --test-concurrency=4 'test/smoke/**/*.test.ts' 'test/unit/**/*.test.ts' 'test/integration/**/*.test.ts' 'test/e2e/**/*.test.ts' 'test/types/**/*.test.ts'",
    "test:coverage": "tsx --test --test-concurrency=4 --experimental-test-coverage 'test/smoke/**/*.test.ts' 'test/unit/**/*.test.ts'",
    "build:bookstore-tbox": "node ./scripts/build-bookstore-tbox.mjs",
    "pack:check": "node ./scripts/check-pack.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run build:bookstore-tbox && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "bench": "tsx bench/run.ts",
    "bench:report": "tsx bench/run.ts --report",
    "bench:flame": "0x --output-dir .flame -- node --import tsx/esm bench/run.ts"
  },
  "keywords": [
    "json-schema",
    "validation",
    "type-system",
    "ontology",
    "semantic-web",
    "rdf",
    "jsonld"
  ],
  "author": "Studnicky (https://github.com/Studnicky)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rdfjs/types": "^1.1.0",
    "@sinclair/typebox": "^0.34.48",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.57.0",
    "0x": "^6.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "cytoscape": "^3.33.3",
    "cytoscape-fcose": "^2.2.0",
    "eslint": "^10.3.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-yml": "^3.3.2",
    "eyereasoner": "^21.0.4",
    "fp-ts": "^2.16.11",
    "globals": "^17.4.0",
    "io-ts": "^2.2.22",
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "n3": "^2.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "valibot": "^1.4.0",
    "vitepress": "^1.6.4",
    "vitepress-sidebar": "^1.33.1",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "dependencies": {
    "commander": "^14.0.3"
  }
}

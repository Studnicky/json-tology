{
  "$schema": "https://raw.githubusercontent.com/noocodex/dev-tools/main/schemas/dev-tools.schema.json",
  "strictMode": false,
  "exclude": ["vendor/**"],
  "validators": {
    "callSignatures": { "enabled": true, "severity": "error" },
    "canonicalDeclarations": { "enabled": true, "severity": "error" },
    "caseCollisions": { "enabled": true, "severity": "error" },
    "circularImports": { "enabled": true, "severity": "error" },
    "classInterfaceNaming": { "enabled": true, "severity": "error" },
    "codeDuplication": { "enabled": true, "severity": "error" },
    "codeOrganization": { "enabled": true, "severity": "error" },
    "consecutiveLoggers": { "enabled": true, "severity": "error" },
    "constantsLocation": { "enabled": true, "severity": "error" },
    "constructSignatures": { "enabled": true, "severity": "error" },
    "constructorComplexity": { "enabled": true, "severity": "error", "threshold": 5 },
    "cyclomaticComplexity": { "enabled": true, "severity": "error", "threshold": 15 },
    "declarationMerging": { "enabled": true, "severity": "error" },
    "decorators": { "enabled": true, "severity": "error" },
    "definitionLocation": { "enabled": true, "severity": "error" },
    "directInstantiation": { "enabled": true, "severity": "error" },
    "distCasing": { "enabled": true, "severity": "error" },
    "domainModule": { "enabled": true, "severity": "error" },
    "dynamicImports": { "enabled": true, "severity": "error" },
    "explicitAny": { "enabled": true, "severity": "error" },
    "exportStatements": { "enabled": true, "severity": "error" },
    "exportUniqueness": { "enabled": true, "severity": "error" },
    "functionCohesion": { "enabled": true, "severity": "warning", "maxDomainTypes": 5 },
    "functionLength": { "enabled": true, "severity": "warning", "threshold": 75 },
    "functionReturnTypeNaming": { "enabled": true, "severity": "error" },
    "functionTypes": { "enabled": true, "severity": "error" },
    "genericConstraints": { "enabled": true, "severity": "error" },
    "genericErrors": { "enabled": true, "severity": "error" },
    "importAliases": { "enabled": true, "severity": "error" },
    "importStatements": { "enabled": true, "severity": "error" },
    "indexSignatures": { "enabled": true, "severity": "error" },
    "interfaceAdherence": { "enabled": true, "severity": "error" },
    "interfaceImplementation": { "enabled": true, "severity": "error" },
    "magicNumbers": { "enabled": true, "severity": "error" },
    "maxFileLength": { "enabled": true, "severity": "warning", "threshold": 500 },
    "methodReturnTypeNaming": { "enabled": true, "severity": "error" },
    "moduleDependencies": { "enabled": true, "severity": "error" },
    "namespaceUsage": { "enabled": true, "severity": "error" },
    "nestingDepth": { "enabled": true, "severity": "warning", "threshold": 6 },
    "noDefaultExport": { "enabled": true, "severity": "error" },
    "noMixedConcerns": { "enabled": true, "severity": "warning" },
    "nonNullAssertions": { "enabled": true, "severity": "error" },
    "noReExports": { "enabled": true, "severity": "error" },
    "parameterSignature": { "enabled": true, "severity": "error", "threshold": 4, "requireOptionsObject": true },
    "publicApiExports": { "enabled": true, "severity": "error" },
    "regexLocation": { "enabled": true, "severity": "error" },
    "singleExport": { "enabled": true, "severity": "error" },
    "singleUseAbstraction": { "enabled": true, "severity": "error", "minImplementations": 2 },
    "subpathExportContents": { "enabled": true, "severity": "error" },
    "subpathExports": { "enabled": true, "severity": "error" },
    "suppressionComments": { "enabled": true, "severity": "error" },
    "testSkip": { "enabled": true, "severity": "error", "ignore": [] },
    "trivialWrappers": { "enabled": true, "severity": "error" },
    "tsConfig": { "enabled": true, "severity": "error" },
    "tsDoc": { "enabled": true, "severity": "error" },
    "typeAssertions": { "enabled": true, "severity": "error" },
    "typeLocation": { "enabled": true, "severity": "error" },
    "typeOnlyImports": { "enabled": true, "severity": "error" },
    "typeRedeclaration": { "enabled": true, "severity": "error" },
    "typeResolution": { "enabled": true, "severity": "error" },
    "typesEntryExclusive": { "enabled": true, "severity": "error" },
    "unsafeTypes": { "enabled": true, "severity": "error" },
    "utilityCoherence": { "enabled": true, "severity": "error", "cohesionThreshold": 0.8 }
  },
  "lint": {
    "eslint": { "enabled": true },
    "ignorefile": { "enabled": true },
    "json": { "enabled": true },
    "rdf": {
      "enabled": true,
      "preserveComments": true,
      "sortPrefixes": "alphabetical",
      "sortTriples": []
    },
    "yaml": { "enabled": true }
  },
  "coverage": {
    "threshold": 80
  },
  "licenses": {
    "exclude": ["AGPL-3.0", "GPL-2.0", "GPL-3.0", "LGPL-2.1", "LGPL-3.0", "UNLICENSED"],
    "include": ["0BSD", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "CC-BY-4.0", "CC0-1.0", "ISC", "MIT"]
  }
}

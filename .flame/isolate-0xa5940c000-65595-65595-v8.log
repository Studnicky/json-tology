script-source,445,file:///Users/studs/Workspace/json-tology/node_modules/@sinclair/typebox/build/esm/type/transform/transform.mjs,import { TransformKind } from '../symbols/index.mjs';\n// ------------------------------------------------------------------\n// TypeGuard\n// ------------------------------------------------------------------\nimport { IsTransform } from '../guard/kind.mjs';\n// ------------------------------------------------------------------\n// TransformBuilders\n// ------------------------------------------------------------------\nexport class TransformDecodeBuilder {\n    constructor(schema) {\n        this.schema = schema;\n    }\n    Decode(decode) {\n        return new TransformEncodeBuilder(this.schema\x2C decode);\n    }\n}\n// prettier-ignore\nexport class TransformEncodeBuilder {\n    constructor(schema\x2C decode) {\n        this.schema = schema;\n        this.decode = decode;\n    }\n    EncodeTransform(encode\x2C schema) {\n        const Encode = (value) => schema[TransformKind].Encode(encode(value));\n        const Decode = (value) => this.decode(schema[TransformKind].Decode(value));\n        const Codec = { Encode: Encode\x2C Decode: Decode };\n        return { ...schema\x2C [TransformKind]: Codec };\n    }\n    EncodeSchema(encode\x2C schema) {\n        const Codec = { Decode: this.decode\x2C Encode: encode };\n        return { ...schema\x2C [TransformKind]: Codec };\n    }\n    Encode(encode) {\n        return (IsTransform(this.schema) ? this.EncodeTransform(encode\x2C this.schema) : this.EncodeSchema(encode\x2C this.schema));\n    }\n}\n/** `[Json]` Creates a Transform type */\nexport function Transform(schema) {\n    return new TransformDecodeBuilder(schema);\n}\n

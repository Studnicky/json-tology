script-source,319,file:///Users/studs/Workspace/json-tology/node_modules/@sinclair/typebox/build/esm/type/extends/extends-from-mapped-key.mjs,import { MappedResult } from '../mapped/index.mjs';\nimport { Literal } from '../literal/index.mjs';\nimport { Extends } from './extends.mjs';\nimport { Clone } from '../clone/value.mjs';\n// prettier-ignore\nfunction FromPropertyKey(K\x2C U\x2C L\x2C R\x2C options) {\n    return {\n        [K]: Extends(Literal(K)\x2C U\x2C L\x2C R\x2C Clone(options))\n    };\n}\n// prettier-ignore\nfunction FromPropertyKeys(K\x2C U\x2C L\x2C R\x2C options) {\n    return K.reduce((Acc\x2C LK) => {\n        return { ...Acc\x2C ...FromPropertyKey(LK\x2C U\x2C L\x2C R\x2C options) };\n    }\x2C {});\n}\n// prettier-ignore\nfunction FromMappedKey(K\x2C U\x2C L\x2C R\x2C options) {\n    return FromPropertyKeys(K.keys\x2C U\x2C L\x2C R\x2C options);\n}\n// prettier-ignore\nexport function ExtendsFromMappedKey(T\x2C U\x2C L\x2C R\x2C options) {\n    const P = FromMappedKey(T\x2C U\x2C L\x2C R\x2C options);\n    return MappedResult(P);\n}\n

script-source,266,file:///Users/studs/Workspace/json-tology/node_modules/@sinclair/typebox/build/esm/type/template-literal/parse.mjs,import { TypeBoxError } from '../error/index.mjs';\n// ------------------------------------------------------------------\n// TemplateLiteralParserError\n// ------------------------------------------------------------------\nexport class TemplateLiteralParserError extends TypeBoxError {\n}\n// -------------------------------------------------------------------\n// Unescape\n//\n// Unescape for these control characters specifically. Note that this\n// function is only called on non union group content\x2C and where we\n// still want to allow the user to embed control characters in that\n// content. For review.\n// -------------------------------------------------------------------\n// prettier-ignore\nfunction Unescape(pattern) {\n    return pattern\n        .replace(/\\\\\\$/g\x2C '$')\n        .replace(/\\\\\\*/g\x2C '*')\n        .replace(/\\\\\\^/g\x2C '^')\n        .replace(/\\\\\\|/g\x2C '|')\n        .replace(/\\\\\\(/g\x2C '(')\n        .replace(/\\\\\\)/g\x2C ')');\n}\n// -------------------------------------------------------------------\n// Control Characters\n// -------------------------------------------------------------------\nfunction IsNonEscaped(pattern\x2C index\x2C char) {\n    return pattern[index] === char && pattern.charCodeAt(index - 1) !== 92;\n}\nfunction IsOpenParen(pattern\x2C index) {\n    return IsNonEscaped(pattern\x2C index\x2C '(');\n}\nfunction IsCloseParen(pattern\x2C index) {\n    return IsNonEscaped(pattern\x2C index\x2C ')');\n}\nfunction IsSeparator(pattern\x2C index) {\n    return IsNonEscaped(pattern\x2C index\x2C '|');\n}\n// -------------------------------------------------------------------\n// Control Groups\n// -------------------------------------------------------------------\nfunction IsGroup(pattern) {\n    if (!(IsOpenParen(pattern\x2C 0) && IsCloseParen(pattern\x2C pattern.length - 1)))\n        return false;\n    let count = 0;\n    for (let index = 0; index < pattern.length; index++) {\n        if (IsOpenParen(pattern\x2C index))\n            count += 1;\n        if (IsCloseParen(pattern\x2C index))\n            count -= 1;\n        if (count === 0 && index !== pattern.length - 1)\n            return false;\n    }\n    return true;\n}\n// prettier-ignore\nfunction InGroup(pattern) {\n    return pattern.slice(1\x2C pattern.length - 1);\n}\n// prettier-ignore\nfunction IsPrecedenceOr(pattern) {\n    let count = 0;\n    for (let index = 0; index < pattern.length; index++) {\n        if (IsOpenParen(pattern\x2C index))\n            count += 1;\n        if (IsCloseParen(pattern\x2C index))\n            count -= 1;\n        if (IsSeparator(pattern\x2C index) && count === 0)\n            return true;\n    }\n    return false;\n}\n// prettier-ignore\nfunction IsPrecedenceAnd(pattern) {\n    for (let index = 0; index < pattern.length; index++) {\n        if (IsOpenParen(pattern\x2C index))\n            return true;\n    }\n    return false;\n}\n// prettier-ignore\nfunction Or(pattern) {\n    let [count\x2C start] = [0\x2C 0];\n    const expressions = [];\n    for (let index = 0; index < pattern.length; index++) {\n        if (IsOpenParen(pattern\x2C index))\n            count += 1;\n        if (IsCloseParen(pattern\x2C index))\n            count -= 1;\n        if (IsSeparator(pattern\x2C index) && count === 0) {\n            const range = pattern.slice(start\x2C index);\n            if (range.length > 0)\n                expressions.push(TemplateLiteralParse(range));\n            start = index + 1;\n        }\n    }\n    const range = pattern.slice(start);\n    if (range.length > 0)\n        expressions.push(TemplateLiteralParse(range));\n    if (expressions.length === 0)\n        return { type: 'const'\x2C const: '' };\n    if (expressions.length === 1)\n        return expressions[0];\n    return { type: 'or'\x2C expr: expressions };\n}\n// prettier-ignore\nfunction And(pattern) {\n    function Group(value\x2C index) {\n        if (!IsOpenParen(value\x2C index))\n            throw new TemplateLiteralParserError(`TemplateLiteralParser: Index must point to open parens`);\n        let count = 0;\n        for (let scan = index; scan < value.length; scan++) {\n            if (IsOpenParen(value\x2C scan))\n                count += 1;\n            if (IsCloseParen(value\x2C scan))\n                count -= 1;\n            if (count === 0)\n                return [index\x2C scan];\n        }\n        throw new TemplateLiteralParserError(`TemplateLiteralParser: Unclosed group parens in expression`);\n    }\n    function Range(pattern\x2C index) {\n        for (let scan = index; scan < pattern.length; scan++) {\n            if (IsOpenParen(pattern\x2C scan))\n                return [index\x2C scan];\n        }\n        return [index\x2C pattern.length];\n    }\n    const expressions = [];\n    for (let index = 0; index < pattern.length; index++) {\n        if (IsOpenParen(pattern\x2C index)) {\n            const [start\x2C end] = Group(pattern\x2C index);\n            const range = pattern.slice(start\x2C end + 1);\n            expressions.push(TemplateLiteralParse(range));\n            index = end;\n        }\n        else {\n            const [start\x2C end] = Range(pattern\x2C index);\n            const range = pattern.slice(start\x2C end);\n            if (range.length > 0)\n                expressions.push(TemplateLiteralParse(range));\n            index = end - 1;\n        }\n    }\n    return ((expressions.length === 0) ? { type: 'const'\x2C const: '' } :\n        (expressions.length === 1) ? expressions[0] :\n            { type: 'and'\x2C expr: expressions });\n}\n// ------------------------------------------------------------------\n// TemplateLiteralParse\n// ------------------------------------------------------------------\n/** Parses a pattern and returns an expression tree */\nexport function TemplateLiteralParse(pattern) {\n    // prettier-ignore\n    return (IsGroup(pattern) ? TemplateLiteralParse(InGroup(pattern)) :\n        IsPrecedenceOr(pattern) ? Or(pattern) :\n            IsPrecedenceAnd(pattern) ? And(pattern) :\n                { type: 'const'\x2C const: Unescape(pattern) });\n}\n// ------------------------------------------------------------------\n// TemplateLiteralParseExact\n// ------------------------------------------------------------------\n/** Parses a pattern and strips forward and trailing ^ and $ */\nexport function TemplateLiteralParseExact(pattern) {\n    return TemplateLiteralParse(pattern.slice(1\x2C pattern.length - 1));\n}\n

{\n  if (bufs.length === 0) {\n    return kEmptyBuffer;\n  }\n\n  if (bufs.length === 1) {\n    return bufs[0];\n  }\n\n  return Buffer.concat(bufs\x2C len);\n}\n\nmodule.exports = Utf8Stream;\n

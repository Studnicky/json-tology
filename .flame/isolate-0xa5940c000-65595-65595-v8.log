script-source,182,node:internal/blocklist,'use strict';\n\nconst {\n  ArrayIsArray\x2C\n  Boolean\x2C\n  JSONParse\x2C\n  NumberParseInt\x2C\n  ObjectSetPrototypeOf\x2C\n  Symbol\x2C\n} = primordials;\n\nconst {\n  BlockList: BlockListHandle\x2C\n} = internalBinding('block_list');\n\nconst {\n  customInspectSymbol: kInspect\x2C\n} = require('internal/util');\n\nconst {\n  SocketAddress\x2C\n  kHandle: kSocketAddressHandle\x2C\n} = require('internal/socketaddress');\n\nconst {\n  markTransferMode\x2C\n  kClone\x2C\n  kDeserialize\x2C\n} = require('internal/worker/js_transferable');\n\nconst { inspect } = require('internal/util/inspect');\n\nconst kHandle = Symbol('kHandle');\nconst { owner_symbol } = internalBinding('symbols');\n\nconst {\n  ERR_INVALID_ARG_VALUE\x2C\n  ERR_INVALID_ARG_TYPE\x2C\n} = require('internal/errors').codes;\n\nconst { validateInt32\x2C validateString } = require('internal/validators');\n\nclass BlockList {\n  constructor() {\n    markTransferMode(this\x2C true\x2C false);\n    this[kHandle] = new BlockListHandle();\n    this[kHandle][owner_symbol] = this;\n  }\n\n  /**\n   * Returns true if the value is a BlockList\n   * @param {any} value\n   * @returns {boolean}\n   */\n  static isBlockList(value) {\n    return value?.[kHandle] !== undefined;\n  }\n\n  [kInspect](depth\x2C options) {\n    if (depth < 0)\n      return this;\n\n    const opts = {\n      ...options\x2C\n      depth: options.depth == null ? null : options.depth - 1\x2C\n    };\n\n    return `BlockList ${inspect({\n      rules: this.rules\x2C\n    }\x2C opts)}`;\n  }\n\n  addAddress(address\x2C family = 'ipv4') {\n    if (!SocketAddress.isSocketAddress(address)) {\n      validateString(address\x2C 'address');\n      validateString(family\x2C 'family');\n      address = new SocketAddress({\n        address\x2C\n        family\x2C\n      });\n    }\n    this[kHandle].addAddress(address[kSocketAddressHandle]);\n  }\n\n  addRange(start\x2C end\x2C family = 'ipv4') {\n    if (!SocketAddress.isSocketAddress(start)) {\n      validateString(start\x2C 'start');\n      validateString(family\x2C 'family');\n      start = new SocketAddress({\n        address: start\x2C\n        family\x2C\n      });\n    }\n    if (!SocketAddress.isSocketAddress(end)) {\n      validateString(end\x2C 'end');\n      validateString(family\x2C 'family');\n      end = new SocketAddress({\n        address: end\x2C\n        family\x2C\n      });\n    }\n    const ret = this[kHandle].addRange(\n      start[kSocketAddressHandle]\x2C\n      end[kSocketAddressHandle]);\n    if (ret === false)\n      throw new ERR_INVALID_ARG_VALUE('start'\x2C start\x2C 'must come before end');\n  }\n\n  addSubnet(network\x2C prefix\x2C family = 'ipv4') {\n    if (!SocketAddress.isSocketAddress(network)) {\n      validateString(network\x2C 'network');\n      validateString(family\x2C 'family');\n      network = new SocketAddress({\n        address: network\x2C\n        family\x2C\n      });\n    }\n    switch (network.family) {\n      case 'ipv4':\n        validateInt32(prefix\x2C 'prefix'\x2C 0\x2C 32);\n        break;\n      case 'ipv6':\n        validateInt32(prefix\x2C 'prefix'\x2C 0\x2C 128);\n        break;\n    }\n    this[kHandle].addSubnet(network[kSocketAddressHandle]\x2C prefix);\n  }\n\n  check(address\x2C family = 'ipv4') {\n    if (!SocketAddress.isSocketAddress(address)) {\n      validateString(address\x2C 'address');\n      validateString(family\x2C 'family');\n      try {\n        address = new SocketAddress({\n          address\x2C\n          family\x2C\n        });\n      } catch {\n        // Ignore the error. If it's not a valid address\x2C return false.\n        return false;\n      }\n    }\n    return Boolean(this[kHandle].check(address[kSocketAddressHandle]));\n  }\n\n  /*\n  * @param {string[]} data\n  * @example\n  * const data = [\n  *   // IPv4 examples\n  *   'Subnet: IPv4 192.168.1.0/24'\x2C\n  *   'Address: IPv4 10.0.0.5'\x2C\n  *   'Range: IPv4 192.168.2.1-192.168.2.10'\x2C\n  *   'Range: IPv4 10.0.0.1-10.0.0.10'\x2C\n  *\n  *   // IPv6 examples\n  *   'Subnet: IPv6 2001:0db8:85a3:0000:0000:8a2e:0370:7334/64'\x2C\n  *   'Address: IPv6 2001:0db8:85a3:0000:0000:8a2e:0370:7334'\x2C\n  *   'Range: IPv6 2001:0db8:85a3:0000:0000:8a2e:0370:7334-2001:0db8:85a3:0000:0000:8a2e:0370:7335'\x2C\n  *   'Subnet: IPv6 2001:db8:1234::/48'\x2C\n  *   'Address: IPv6 2001:db8:1234::1'\x2C\n  *   'Range: IPv6 2001:db8:1234::1-2001:db8:1234::10'\n  * ];\n  */\n  #parseIPInfo(data) {\n    for (const item of data) {\n      if (item.includes('IPv4')) {\n        const subnetMatch = item.match(\n          /Subnet: IPv4 (\\d{1\x2C3}(?:\\.\\d{1\x2C3}){3})\\/(\\d{1\x2C2})/\x2C\n        );\n        if (subnetMatch) {\n          const { 1: network\x2C 2: prefix } = subnetMatch;\n          this.addSubnet(network\x2C NumberParseInt(prefix));\n          continue;\n        }\n        const addressMatch = item.match(/Address: IPv4 (\\d{1\x2C3}(?:\\.\\d{1\x2C3}){3})/);\n        if (addressMatch) {\n          const { 1: address } = addressMatch;\n          this.addAddress(address);\n          continue;\n        }\n\n        const rangeMatch = item.match(\n          /Range: IPv4 (\\d{1\x2C3}(?:\\.\\d{1\x2C3}){3})-(\\d{1\x2C3}(?:\\.\\d{1\x2C3}){3})/\x2C\n        );\n        if (rangeMatch) {\n          const { 1: start\x2C 2: end } = rangeMatch;\n          this.addRange(start\x2C end);\n          continue;\n        }\n      }\n      // IPv6 parsing with support for compressed addresses\n      if (item.includes('IPv6')) {\n        // IPv6 subnet pattern: supports both full and compressed formats\n        // Examples:\n        // - 2001:0db8:85a3:0000:0000:8a2e:0370:7334/64 (full)\n        // - 2001:db8:85a3::8a2e:370:7334/64 (compressed)\n        // - 2001:db8:85a3::192.0.2.128/64 (mixed)\n        const ipv6SubnetMatch = item.match(\n          /Subnet: IPv6 ([0-9a-fA-F:]{1\x2C39})\\/([0-9]{1\x2C3})/i\x2C\n        );\n        if (ipv6SubnetMatch) {\n          const { 1: network\x2C 2: prefix } = ipv6SubnetMatch;\n          this.addSubnet(network\x2C NumberParseInt(prefix)\x2C 'ipv6');\n          continue;\n        }\n\n        // IPv6 address pattern: supports both full and compressed formats\n        // Examples:\n        // - 2001:0db8:85a3:0000:0000:8a2e:0370:7334 (full)\n        // - 2001:db8:85a3::8a2e:370:7334 (compressed)\n        // - 2001:db8:85a3::192.0.2.128 (mixed)\n        const ipv6AddressMatch = item.match(/Address: IPv6 ([0-9a-fA-F:]{1\x2C39})/i);\n        if (ipv6AddressMatch) {\n          const { 1: address } = ipv6AddressMatch;\n          this.addAddress(address\x2C 'ipv6');\n          continue;\n        }\n\n        // IPv6 range pattern: supports both full and compressed formats\n        // Examples:\n        // - 2001:0db8:85a3:0000:0000:8a2e:0370:7334-2001:0db8:85a3:0000:0000:8a2e:0370:7335 (full)\n        // - 2001:db8:85a3::8a2e:370:7334-2001:db8:85a3::8a2e:370:7335 (compressed)\n        // - 2001:db8:85a3::192.0.2.128-2001:db8:85a3::192.0.2.129 (mixed)\n        const ipv6RangeMatch = item.match(/Range: IPv6 ([0-9a-fA-F:]{1\x2C39})-([0-9a-fA-F:]{1\x2C39})/i);\n        if (ipv6RangeMatch) {\n          const { 1: start\x2C 2: end } = ipv6RangeMatch;\n          this.addRange(start\x2C end\x2C 'ipv6');\n          continue;\n        }\n      }\n    }\n  }\n\n\n  toJSON() {\n    return this.rules;\n  }\n\n  fromJSON(data) {\n    // The data argument must be a string\x2C or an array of strings that\n    // is JSON parseable.\n    if (ArrayIsArray(data)) {\n      for (const n of data) {\n        if (typeof n !== 'string') {\n          throw new ERR_INVALID_ARG_TYPE('data'\x2C ['string'\x2C 'string[]']\x2C data);\n        }\n      }\n    } else if (typeof data !== 'string') {\n      throw new ERR_INVALID_ARG_TYPE('data'\x2C ['string'\x2C 'string[]']\x2C data);\n    } else {\n      data = JSONParse(data);\n      if (!ArrayIsArray(data)) {\n        throw new ERR_INVALID_ARG_TYPE('data'\x2C ['string'\x2C 'string[]']\x2C data);\n      }\n      for (const n of data) {\n        if (typeof n !== 'string') {\n          throw new ERR_INVALID_ARG_TYPE('data'\x2C ['string'\x2C 'string[]']\x2C data);\n        }\n      }\n    }\n\n    this.#parseIPInfo(data);\n  }\n\n\n  get rules() {\n    return this[kHandle].getRules();\n  }\n  [kClone]() {\n    const handle = this[kHandle];\n    return {\n      data: { handle }\x2C\n      deserializeInfo: 'internal/blocklist:InternalBlockList'\x2C\n    };\n  }\n\n  [kDeserialize]({ handle }) {\n    this[kHandle] = handle;\n    this[kHandle][owner_symbol] = this;\n  }\n}\n\nclass InternalBlockList {\n  constructor(handle) {\n    markTransferMode(this\x2C true\x2C false);\n    this[kHandle] = handle;\n    if (handle !== undefined)\n      handle[owner_symbol] = this;\n  }\n}\n\nInternalBlockList.prototype.constructor = BlockList.prototype.constructor;\nObjectSetPrototypeOf(InternalBlockList.prototype\x2C BlockList.prototype);\n\nmodule.exports = {\n  BlockList\x2C\n  InternalBlockList\x2C\n};\n

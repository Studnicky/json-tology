       }\n\n        // ! This line catches initialization errors in the worker thread.\n        this.#unwrapMessage(response);\n      }\n\n      this.#isReady = true;\n    }\n  }\n\n  /**\n   * Invoke a remote method asynchronously.\n   * @param {string} method Method to invoke\n   * @param {any[]} [transferList] Objects in `args` to be transferred\n   * @param {any[]} args Arguments to pass to `method`\n   * @returns {Promise<any>}\n   */\n  async makeAsyncRequest(method\x2C transferList\x2C ...args) {\n    this.waitForWorker();\n\n    MessageChannel ??= require('internal/worker/io').MessageChannel;\n    const asyncCommChannel = new MessageChannel();\n\n    // Pass work to the worker.\n    debug('post async message to worker'\x2C { method\x2C args\x2C transferList });\n    const finalTransferList = [asyncCommChannel.port2];\n    if (transferList) {\n      ArrayPrototypePushApply(finalTransferList\x2C transferList);\n    }\n    this.#worker.postMessage({\n      __proto__: null\x2C\n      method\x2C args\x2C\n      port: asyncCommChannel.port2\x2C\n    }\x2C finalTransferList);\n\n    if (this.#numberOfPendingAsyncResponses++ === 0) {\n      // On the next lines\x2C the main thread will await a response from the worker thread that might\n      // come AFTER the last task in the event loop has run its course and there would be nothing\n      // left keeping the thread alive (and once the main thread dies\x2C the whole process stops).\n      // However we want to keep the process alive until the worker thread responds (or until the\n      // event loop of the worker thread is also empty)\x2C so we ref the worker until we get all the\n      // responses back.\n      this.#worker.ref();\n    }\n\n    let response;\n    do {\n      debug('wait for async response from worker'\x2C { method\x2C args });\n      await AtomicsWaitAsync(this.#lock\x2C WORKER_TO_MAIN_THREAD_NOTIFICATION\x2C this.#workerNotificationLastId).value;\n      this.#workerNotificationLastId = AtomicsLoad
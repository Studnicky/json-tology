script-source,200,file:///Users/studs/Workspace/json-tology/bench/run.ts,import{printResults}from"./harness.js";import{runValidateBench}from"./validate.bench.js";import{runValueParseBench}from"./valueParse.bench.js";import{runValueOpsBench}from"./valueOps.bench.js";console.log("");console.log("json-tology vs TypeBox \\u2014 performance benchmarks");console.log(`Node ${process.version}  \\u2022  ${new Date().toISOString()}`);const allResults=[];const validateResults=runValidateBench();printResults(validateResults);allResults.push(...validateResults);const parseResults=runValueParseBench();printResults(parseResults);allResults.push(...parseResults);const opsResults=runValueOpsBench();printResults(opsResults);allResults.push(...opsResults);console.log("\\u2550".repeat(80));console.log("SUMMARY");console.log("\\u2550".repeat(80));let wins=0;let losses=0;for(let i=0;i<allResults.length-1;i+=2){const ours=allResults[i];const theirs=allResults[i+1];const ratio=ours.opsPerSec/theirs.opsPerSec;const faster=ratio>=1;if(faster)wins++;else losses++;const label=faster?`\\u2713 ${ratio.toFixed(2)}x faster`:`\\u2717 ${(1/ratio).toFixed(2)}x slower`;console.log(`  ${ours.name.replace(/ours\\s+/\x2C"").padEnd(35)}  ${label}`)}console.log("");console.log(`Result: ${wins} wins\x2C ${losses} losses out of ${wins+losses} comparisons`);console.log("");\n\n//# sourceMappingURL=data:application/json;base64\

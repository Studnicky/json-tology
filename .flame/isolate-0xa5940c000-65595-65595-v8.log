e\nfunction MappedKeyToMappedResultProperties(K\x2C P) {\n    return (SetIncludes(P\x2C K)\n        ? MappedKeyToKnownMappedResultProperties(K)\n        : MappedKeyToUnknownMappedResultProperties(P));\n}\n// prettier-ignore\nfunction FromMappedKey(K\x2C P) {\n    const R = MappedKeyToMappedResultProperties(K\x2C P);\n    return FromMappedResult(K\x2C R);\n}\n// prettier-ignore\nfunction FromRest(K\x2C T) {\n    return T.map(L => FromSchemaType(K\x2C L));\n}\n// prettier-ignore\nfunction FromProperties(K\x2C T) {\n    const Acc = {};\n    for (const K2 of globalThis.Object.getOwnPropertyNames(T))\n        Acc[K2] = FromSchemaType(K\x2C T[K2]);\n    return Acc;\n}\n// prettier-ignore\nfunction FromSchemaType(K\x2C T) {\n    // required to retain user defined options for mapped type\n    const options = { ...T };\n    return (\n    // unevaluated modifier types\n    IsOptional(T) ? Optional(FromSchemaType(K\x2C Discard(T\x2C [OptionalKind]))) :\n        IsReadonly(T) ? Readonly(FromSchemaType(K\x2C Discard(T\x2C [ReadonlyKind]))) :\n            // unevaluated mapped types\n            IsMappedResult(T) ? FromMappedResult(K\x2C T.properties) :\n                IsMappedKey(T) ? FromMappedKey(K\x2C T.keys) :\n                    // unevaluated types\n                    IsConstructor(T) ? Constructor(FromRest(K\x2C T.parameters)\x2C FromSchemaType(K\x2C T.returns)\x2C options) :\n                        IsFunction(T) ? FunctionType(FromRest(K\x2C T.parameters)\x2C FromSchemaType(K\x2C T.returns)\x2C options) :\n                            IsAsyncIterator(T) ? AsyncIterator(FromSchemaType(K\x2C T.items)\x2C options) :\n                                IsIterator(T) ? Iterator(FromSchemaType(K\x2C T.items)\x2C options) :\n                                    IsIntersect(T) ? Intersect(FromRest(K\x2C T.allOf)\x2C options) :\n                                        IsUnion(T) ? Union(FromRest(K\x2C T.anyOf)\x2C options) :\n                                            IsTuple(T) ? Tuple(FromRest(K\x2C T.items ?? [])\x2C options) :\n                                                IsObject(T) ? Object(FromProperties(K\x2C T.properties)\x2C options) :\n                                                    IsArray(T) ? Array(FromSchemaType(K\x2C T.items)\x2C options) :\n                                                        IsPromise(T) ? Promise(FromSchemaType(K\x2C T.item)\x2C options) :\n                                                            T);\n}\n// prettier-ignore\nexport function MappedFunctionReturnType(K\x2C T) {\n    const Acc = {};\n    for (const L of K)\n        Acc[L] = FromSchemaType(L\x2C T);\n    return Acc;\n}\n/** `[Json]` Creates a Mapped object type */\nexport function Mapped(key\x2C map\x2C options) {\n    const K = IsSchema(key) ? IndexPropertyKeys(key) : key;\n    const RT = map({ [Kind]: 'MappedKey'\x2C keys: K });\n    const R = MappedFunctionReturnType(K\x2C RT);\n    return Object(R\x2C options);\n}\n

script-source,449,file:///Users/studs/Workspace/json-tology/node_modules/@sinclair/typebox/build/esm/type/type/json.mjs,import { Any } from '../any/index.mjs';\nimport { Array } from '../array/index.mjs';\nimport { Boolean } from '../boolean/index.mjs';\nimport { Composite } from '../composite/index.mjs';\nimport { Const } from '../const/index.mjs';\nimport { Enum } from '../enum/index.mjs';\nimport { Exclude } from '../exclude/index.mjs';\nimport { Extends } from '../extends/index.mjs';\nimport { Extract } from '../extract/index.mjs';\nimport { Index } from '../indexed/index.mjs';\nimport { Integer } from '../integer/index.mjs';\nimport { Intersect } from '../intersect/index.mjs';\nimport { Capitalize\x2C Uncapitalize\x2C Lowercase\x2C Uppercase } from '../intrinsic/index.mjs';\nimport { KeyOf } from '../keyof/index.mjs';\nimport { Literal } from '../literal/index.mjs';\nimport { Mapped } from '../mapped/index.mjs';\nimport { Never } from '../never/index.mjs';\nimport { Not } from '../not/index.mjs';\nimport { Null } from '../null/index.mjs';\nimport { Module } from '../module/index.mjs';\nimport { Number } from '../number/index.mjs';\nimport { Object } from '../object/index.mjs';\nimport { Omit } from '../omit/index.mjs';\nimport { Optional } from '../optional/index.mjs';\nimport { Partial } from '../partial/index.mjs';\nimport { Pick } from '../pick/index.mjs';\nimport { Readonly } from '../readonly/index.mjs';\nimport { ReadonlyOptional } from '../readonly-optional/index.mjs';\nimport { Record } from '../record/index.mjs';\nimport { Recursive } from '../recursive/index.mjs';\nimport { Ref } from '../ref/index.mjs';\nimport { Required } from '../required/index.mjs';\nimport { Rest } from '../rest/index.mjs';\nimport { String } from '../string/index.mjs';\nimport { TemplateLiteral } from '../template-literal/index.mjs';\nimport { Transform } from '../transform/index.mjs';\nimport { Tuple } from '../tuple/index.mjs';\nimport { Union } from '../union/index.mjs';\nimport { Unknown } from '../unknown/index.mjs';\nimport { Unsafe } from '../unsafe/index.mjs';\n/** Json Type Builder with Static Resolution for TypeScript */\nexport class JsonTypeBuilder {\n    // ------------------------------------------------------------------------\n    // Modifiers\n    // ------------------------------------------------------------------------\n    /** `[Json]` Creates a Readonly and Optional property */\n    ReadonlyOptional(type) {\n        return ReadonlyOptional(type);\n    }\n    /** `[Json]` Creates a Readonly property */\n    Readonly(type\x2C enable) {\n        return Readonly(type\x2C enable ?? true);\n    }\n    /** `[Json]` Creates a Optional property */\n    Optional(type\x2C enable) {\n        return Optional(type\x2C enable ?? true);\n    }\n    // ------------------------------------------------------------------------\n    // Types\n    // ------------------------------------------------------------------------\n    /** `[Json]` Creates an Any type */\n    Any(options) {\n        return Any(options);\n    }\n    /** `[Json]` Creates an Array type */\n    Array(items\x2C options) {\n        return Array(items\x2C options);\n    }\n    /** `[Json]` Creates a Boolean type */\n    Boolean(options) {\n        return Boolean(options);\n    }\n    /** `[Json]` Intrinsic function to Capitalize LiteralString types */\n    Capitalize(schema\x2C options) {\n        return Capitalize(schema\x2C options);\n    }\n    /** `[Json]` Creates a Composite object type */\n    Composite(schemas\x2C options) {\n        return Composite(schemas\x2C options); // (error) TS 5.4.0-dev - review TComposite implementation\n    }\n    /** `[JavaScript]` Creates a readonly const type from the given value. */\n    Const(value\x2C options) {\n        return Const(value\x2C options);\n    }\n    /** `[Json]` Creates a Enum type */\n    Enum(item\x2C options) {\n        return Enum(item\x2C options);\n    }\n    /** `[Json]` Constructs a type by excluding from unionType all union members that are assignable to excludedMembers */\n    Exclude(unionType\x2C excludedMembers\x2C options) {\n        return Exclude(unionType\x2C excludedMembers\x2C options);\n    }\n    /** `[Json]` Creates a Conditional type */\n    Extends(L\x2C R\x2C T\x2C F\x2C options) {\n        return Extends(L\x2C R\x2C T\x2C F\x2C options);\n    }\n    /** `[Json]` Constructs a type by extracting from type all union members that are assignable to union */\n    Extract(type\x2C union\x2C options) {\n        return Extract(type\x2C union\x2C options);\n    }\n    /** `[Json]` Returns an Indexed property type for the given keys */\n    Index(type\x2C key\x2C options) {\n        return Index(type\x2C key\x2C options);\n    }\n    /** `[Json]` Creates an Integer type */\n    Integer(options) {\n        return Integer(options);\n    }\n    /** `[Json]` Creates an Intersect type */\n    Intersect(types\x2C options) {\n        return Intersect(types\x2C options);\n    }\n    /** `[Json]` Creates a KeyOf type */\n    KeyOf(type\x2C options) {\n        return KeyOf(type\x2C options);\n    }\n    /** `[Json]` Creates a Literal type */\n    Literal(literalValue\x2C options) {\n        return Literal(literalValue\x2C options);\n    }\n    /** `[Json]` Intrinsic function to Lowercase LiteralString types */\n    Lowercase(type\x2C options) {\n        return Lowercase(type\x2C options);\n    }\n    /** `[Json]` Creates a Mapped object type */\n    Mapped(key\x2C map\x2C options) {\n        return Mapped(key\x2C map\x2C options);\n    }\n    /** `[Json]` Creates a Type Definition Module. */\n    Module(properties) {\n        return Module(properties);\n    }\n    /** `[Json]` Creates a Never type */\n    Never(options) {\n        return Never(options);\n    }\n    /** `[Json]` Creates a Not type */\n    Not(type\x2C options) {\n        return Not(type\x2C options);\n    }\n    /** `[Json]` Creates a Null type */\n    Null(options) {\n        return Null(options);\n    }\n    /** `[Json]` Creates a Number type */\n    Number(options) {\n        return Number(options);\n    }\n    /** `[Json]` Creates an Object type */\n    Object(properties\x2C options) {\n        return Object(properties\x2C options);\n    }\n    /** `[Json]` Constructs a type whose keys are omitted from the given type */\n    Omit(schema\x2C selector\x2C options) {\n        return Omit(schema\x2C selector\x2C options);\n    }\n    /** `[Json]` Constructs a type where all properties are optional */\n    Partial(type\x2C options) {\n        return Partial(type\x2C options);\n    }\n    /** `[Json]` Constructs a type whose keys are picked from the given type */\n    Pick(type\x2C key\x2C options) {\n        return Pick(type\x2C key\x2C options);\n    }\n    /** `[Json]` Creates a Record type */\n    Record(key\x2C value\x2C options) {\n        return Record(key\x2C value\x2C options);\n    }\n    /** `[Json]` Creates a Recursive type */\n    Recursive(callback\x2C options) {\n        return Recursive(callback\x2C options);\n    }\n    /** `[Json]` Creates a Ref type. The referenced type must contain a $id */\n    Ref(...args) {\n        return Ref(args[0]\x2C args[1]);\n    }\n    /** `[Json]` Constructs a type where all properties are required */\n    Required(type\x2C options) {\n        return Required(type\x2C options);\n    }\n    /** `[Json]` Extracts interior Rest elements from Tuple\x2C Intersect and Union types */\n    Rest(type) {\n        return Rest(type);\n    }\n    /** `[Json]` Creates a String type */\n    String(options) {\n        return String(options);\n    }\n    /** `[Json]` Creates a TemplateLiteral type */\n    TemplateLiteral(unresolved\x2C options) {\n        return TemplateLiteral(unresolved\x2C options);\n    }\n    /** `[Json]` Creates a Transform type */\n    Transform(type) {\n        return Transform(type);\n    }\n    /** `[Json]` Creates a Tuple type */\n    Tuple(types\x2C options) {\n        return Tuple(types\x2C options);\n    }\n    /** `[Json]` Intrinsic function to Uncapitalize LiteralString types */\n    Uncapitalize(type\x2C options) {\n        return Uncapitalize(type\x2C options);\n    }\n    /** `[Json]` Creates a Union type */\n    Union(types\x2C options) {\n        return Union(types\x2C options);\n    }\n    /** `[Json]` Creates an Unknown type */\n    Unknown(options) {\n        return Unknown(options);\n    }\n    /** `[Json]` Creates a Unsafe type that will infers as the generic argument T */\n    Unsafe(options) {\n        return Unsafe(options);\n    }\n    /** `[Json]` Intrinsic function to Uppercase LiteralString types */\n    Uppercase(schema\x2C options) {\n        return Uppercase(schema\x2C options);\n    }\n}\n

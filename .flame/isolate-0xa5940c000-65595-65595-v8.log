script-source,198,node:internal/modules/esm/hooks,'use strict';\n\nconst {\n  ArrayPrototypePush\x2C\n  ArrayPrototypePushApply\x2C\n  AtomicsLoad\x2C\n  AtomicsWait\x2C\n  AtomicsWaitAsync\x2C\n  Int32Array\x2C\n  ObjectAssign\x2C\n  ObjectDefineProperty\x2C\n  ObjectSetPrototypeOf\x2C\n  Promise\x2C\n  ReflectSet\x2C\n  SafeSet\x2C\n  StringPrototypeSlice\x2C\n  StringPrototypeToUpperCase\x2C\n} = primordials;\n\nconst {\n  ERR_ASYNC_LOADER_REQUEST_NEVER_SETTLED\x2C\n  ERR_INTERNAL_ASSERTION\x2C\n  ERR_INVALID_ARG_TYPE\x2C\n  ERR_INVALID_ARG_VALUE\x2C\n  ERR_INVALID_RETURN_PROPERTY_VALUE\x2C\n  ERR_INVALID_RETURN_VALUE\x2C\n  ERR_LOADER_CHAIN_INCOMPLETE\x2C\n  ERR_WORKER_UNSERIALIZABLE_ERROR\x2C\n} = require('internal/errors').codes;\nconst { URLParse } = require('internal/url');\nconst { canParse: URLCanParse } = internalBinding('url');\nconst { receiveMessageOnPort } = require('worker_threads');\nconst {\n  isAnyArrayBuffer\x2C\n  isArrayBufferView\x2C\n} = require('internal/util/types');\nconst {\n  validateObject\x2C\n  validateString\x2C\n} = require('internal/validators');\nconst {\n  constructSharedArrayBuffer\x2C\n  kEmptyObject\x2C\n} = require('internal/util');\n\nconst {\n  defaultResolve\x2C\n  throwIfInvalidParentURL\x2C\n} = require('internal/modules/esm/resolve');\nconst {\n  getDefaultConditions\x2C\n} = require('internal/modules/esm/utils');\nconst { deserializeError } = require('internal/error_serdes');\nconst {\n  SHARED_MEMORY_BYTE_LENGTH\x2C\n  WORKER_TO_MAIN_THREAD_NOTIFICATION\x2C\n} = require('internal/modules/esm/shared_constants');\nlet debug = require('internal/util/debuglog').debuglog('async_loader_worker'\x2C (fn) => {\n  debug = fn;\n});\nlet importMetaInitializer;\n\nlet importAssertionAlreadyWarned = false;\n\nfunction emitImportAssertionWarning() {\n  if (!importAssertionAlreadyWarned) {\n    importAssertionAlreadyWarned = true;\n    process.emitWarning('Use `importAttributes` instead of `importAssertions`'\x2C 'ExperimentalWarning');\n  }\n}\n\nfunction defineImportAssertionAlias(context) {\n  return ObjectDefineProperty(context\x2C 'importAssertions'\x2C {\n    __proto__: null\x2C\n    configurable: true\x2C\n    get() {\n      emitImportAssertionWarning();\n      return this.importAttributes;\n    }\x2C\n    set(value) {\n      emitImportAssertionWarning();\n      return ReflectSet(this\x2C 'importAttributes'\x2C value);\n    }\x2C\n  });\n}\n\n/**\n * @typedef {object} ExportedHooks\n * @property {Function} resolve Resolve hook.\n * @property {Function} load Load hook.\n */\n\n/**\n * @typedef {object} KeyedHook\n * @property {Function} fn The hook function.\n * @property {URL['href']} url The URL of the module.\n * @property {KeyedHook?} next The next hook in the chain.\n */\n\n// [2] `validate...()`s throw the wrong error\n\n/**\n * @typedef {{ format: ModuleFormat\x2C source: ModuleSource }} LoadResult\n */\n\n/**\n * @typedef {{ format: ModuleFormat\x2C url: string\x2C importAttributes: Record<string\x2C string> }} ResolveResult\n */\n\n/**\n * Interface for classes that implement asynchronous loader hooks that can be attached to the ModuleLoader\n * via `ModuleLoader.#setAsyncLoaderHooks()`.\n * @typedef {object} AsyncLoaderHooks\n * @property {boolean} allowImportMetaResolve Whether to allow the use of `import.meta.resolve`.\n * @property {boolean} isForAsyncLoaderHookWorker Whether the instance is running on the loader hook worker thread.\n * @property {(url: string\x2C context: object\x2C defaultLoad: Function) => Promise<LoadResult>} load\n *   Calling the asynchronous `load` hook asynchronously.\n * @property {(url: string\x2C context: object\x2C defaultLoad: Function) => LoadResult} [loadSync]\n *   Calling the asynchronous `load` hook synchronously.\n * @property {(originalSpecifier: string\x2C parentURL: string\x2C\n *             importAttributes: Record<string\x2C string>) => Promise<ResolveResult>} resolve\n *   Calling the asynchronous `resolve` hook asynchronously.\n * @property {(originalSpecifier: string\x2C parentURL: string\x2C\n *            importAttributes: Record<string\x2C string>) => ResolveResult} [resolveSync]\n *   Calling the asynchronous `resolve` hook synchronously.\n * @property {(specifier: string\x2C parentURL: string) => any} register Register asynchronous loader hooks\n * @property {() => void} waitForLoaderHookInitialization Force loading of hooks.\n */\n\n/**\n * @implements {AsyncLoaderHooks}\n * Instances of this class run directly on the loader hook worker thread and customize the module\n * loading of the hooks worker itself.\n */\nclass AsyncLoaderHooksOnLoaderHookWorker {\n  #chains = {\n    /**\n     * Phase 1 of 2 in ESM loading.\n     * The output of the `resolve` chain of hooks is passed into the `load` chain of hooks.\n     * @private\n     * @property {KeyedHook[]} resolve Last-in-first-out collection of resolve hooks.\n     */\n    resolve: [\n      {\n        fn: defaultResolve\x2C\n        url: 'node:internal/modules/esm/resolve'\x2C\n      }\x2C\n    ]\x2C\n\n    /**\n     * Phase 2 of 2 in ESM loading.\n     * @private\n     * @property {KeyedHook[]} load Last-in-first-out collection of loader hooks.\n     */\n    load: [\n      {\n        fn: require('internal/modules/esm/load').defaultLoad\x2C\n        url: 'node:internal/modules/esm/load'\x2C\n      }\x2C\n    ]\x2C\n  };\n\n  // Cache URLs we've already validated to avoid repeated validation\n  #validatedUrls = new SafeSet();\n\n  allowImportMetaResolve = false;\n\n  isForAsyncLoaderHookWorker = true;\n\n  /**\n   * Import and register custom/user-defined module loader hook(s).\n   * @param {string} urlOrSpecifier\n   * @param {string} parentURL\n   * @param {any} [data] Arbitrary data to be passed from the custom\n   *   loader (user-land) to the worker.\n   */\n  async register(urlOrSpecifier\x2C parentURL\x2C data\x2C isInternal) {\n    const cascadedLoader = require('internal/modules/esm/loader').getOrInitializeCascadedLoader();\n    const keyedExports = isInternal ?\n      require(urlOrSpecifier) :\n      await cascadedLoader.import(\n        urlOrSpecifier\x2C\n        parentURL\x2C\n        kEmptyObject\x2C\n      );\n    await this.addCustomLoader(urlOrSpecifier\x2C keyedExports\x2C data);\n  }\n\n  /**\n   * Collect custom/user-defined module loader hook(s).\n   * @param {string} url Custom loader specifier\n   * @param {Record<string\x2C unknown>} exports\n   * @param {any} [data] Arbitrary data to be passed from the custom loader (user-land)\n   *   to the worker.\n   * @returns {any | Promise<any>} User data\x2C ignored unless it's a promise\x2C in which case it will be awaited.\n   */\n  addCustomLoader(url\x2C exports\x2C data) {\n    const {\n      initialize\x2C\n      resolve\x2C\n      load\x2C\n    } = pluckHooks(exports);\n\n    if (resolve) {\n      const next = this.#chains.resolve[this.#chains.resolve.length - 1];\n      ArrayPrototypePush(this.#chains.resolve\x2C { __proto__: null\x2C fn: resolve\x2C url\x2C next });\n    }\n    if (load) {\n      const next = this.#chains.load[this.#chains.load.length - 1];\n      ArrayPrototypePush(this.#chains.load\x2C { __proto__: null\x2C fn: load\x2C url\x2C next });\n    }\n    return initialize?.(data);\n  }\n\n  /**\n   * Resolve the location of the module.\n   *\n   * Internally\x2C this behaves like a backwards iterator\x2C wherein the stack of\n   * hooks starts at the top and each call to `nextResolve()` moves down 1 step\n   * until it reaches the bottom or short-circuits.\n   * @param {string} originalSpecifier The specified URL path of the module to\n   *   be resolved.\n   * @param {string} [parentURL] The URL path of the module's parent.\n   * @param {ImportAttributes} [importAttributes] Attributes from the import\n   *   statement or expression.\n   * @returns {Promise<{ format: string\x2C url: URL['href'] }>}\n   */\n  async resolve(\n    originalSpecifier\x2C\n    parentURL\x2C\n    importAttributes = { __proto__: null }\x2C\n  ) {\n    throwIfInvalidParentURL(parentURL);\n\n    const chain = this.#chains.resolve;\n    const context = {\n      conditions: getDefaultConditions()\x2C\n      importAttributes\x2C\n      parentURL\x2C\n    };\n    const meta = {\n      chainFinished: null\x2C\n      context\x2C\n      hookErrIdentifier: ''\x2C\n      hookName: 'resolve'\x2C\n      shortCircuited: false\x2C\n    };\n\n    const validateArgs = (hookErrIdentifier\x2C suppliedSpecifier\x2C ctx) => {\n      validateString(\n        suppliedSpecifier\x2C\n        `${hookErrIdentifier} specifier`\x2C\n      ); // non-strings can be coerced to a URL string\n\n      if (ctx) { validateObject(ctx\x2C `${hookErrIdentifier} context`); }\n    };\n    const validateOutput = (hookErrIdentifier\x2C output) => {\n      if (typeof output !== 'object' || output === null) { // [2]\n        throw new ERR_INVALID_RETURN_VALUE(\n          'an object'\x2C\n          hookErrIdentifier\x2C\n          output\x2C\n        );\n      }\n    };\n\n    const nextResolve = nextHookFactory(chain[chain.length - 1]\x2C meta\x2C { validateArgs\x2C validateOutput });\n\n    const resolution = await nextResolve(originalSpecifier\x2C defineImportAssertionAlias(context));\n    const { hookErrIdentifier } = meta; // Retrieve the value after all settled\n\n    validateOutput(hookErrIdentifier\x2C resolution);\n\n    if (resolution?.shortCircuit === true) { meta.shortCircuited = true; }\n\n    if (!meta.chainFinished && !meta.shortCircuited) {\n      throw new ERR_LOADER_CHAIN_INCOMPLETE(hookErrIdentifier);\n    }\n\n    let resolvedImportAttributes;\n    const {\n      format\x2C\n      url\x2C\n    } = resolution;\n\n    if (typeof url !== 'string') {\n      // non-strings can be coerced to a URL string\n      // validateString() throws a less-specific error\n      throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n        'a URL string'\x2C\n        hookErrIdentifier\x2C\n        'url'\x2C\n        url\x2C\n      );\n    }\n\n    //
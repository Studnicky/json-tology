script-source,255,file:///Users/studs/Workspace/json-tology/node_modules/@sinclair/typebox/build/esm/type/intersect/intersect-create.mjs,import { CreateType } from '../create/type.mjs';\nimport { Kind } from '../symbols/index.mjs';\n// ------------------------------------------------------------------\n// TypeGuard\n// ------------------------------------------------------------------\nimport { IsObject\x2C IsSchema } from '../guard/kind.mjs';\n// ------------------------------------------------------------------\n// IntersectCreate\n// ------------------------------------------------------------------\n// prettier-ignore\nexport function IntersectCreate(T\x2C options = {}) {\n    const allObjects = T.every((schema) => IsObject(schema));\n    const clonedUnevaluatedProperties = IsSchema(options.unevaluatedProperties)\n        ? { unevaluatedProperties: options.unevaluatedProperties }\n        : {};\n    return CreateType((options.unevaluatedProperties === false || IsSchema(options.unevaluatedProperties) || allObjects\n        ? { ...clonedUnevaluatedProperties\x2C [Kind]: 'Intersect'\x2C type: 'object'\x2C allOf: T }\n        : { ...clonedUnevaluatedProperties\x2C [Kind]: 'Intersect'\x2C allOf: T })\x2C options);\n}\n

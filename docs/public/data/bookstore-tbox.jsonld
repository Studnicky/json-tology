    },\n      \"https://json-tology.dev/vocab#format\": \"uri\"\n    },\n    {\n      \"@id\": \"urn:bookstore:EBookFormat\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#string\"\n      },\n      \"http://www.w3.org/2002/07/owl#equivalentClass\": {\n        \"http://www.w3.org/2002/07/owl#oneOf\": {\n          \"@list\": [\n            \"epub\",\n            \"pdf\",\n            \"mobi\"\n          ]\n        }\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Email\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#string\"\n      },\n      \"https://json-tology.dev/vocab#format\": \"email\"\n    },\n    {\n      \"@id\": \"urn:bookstore:EstimatedAgeYears\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#integer\"\n      },\n      \"http://www.w3.org/2002/07/owl#withRestrictions\": {\n        \"@list\": [\n          {\n            \"http://www.w3.org/2001/XMLSchema#minInclusive\": 0\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:FileSizeBytes\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#integer\"\n      },\n      \"http://www.w3.org/2002/07/owl#withRestrictions\": {\n        \"@list\": [\n          {\n            \"http://www.w3.org/2001/XMLSchema#minInclusive\": 0\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:FirstEditionYear\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#integer\"\n      },\n      \"http://www.w3.org/2002/07/owl#withRestrictions\": {\n        \"@list\": [\n          {\n            \"http://www.w3.org/2001/XMLSchema#maxInclusive\": 2100\n          },\n          {\n            \"http://www.w3.org/2001/XMLSchema#minInclusive\": 1450\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Isbn\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#string\"\n      },\n      \"http://www.w3.org/2002/07/owl#withRestrictions\": {\n        \"@list\": [\n          {\n            \"http://www.w3.org/2001/XMLSchema#pattern\": \"^\\\\d{13}$\"\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Iso8601\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#dateTime\"\n      },\n      \"https://json-tology.dev/vocab#format\": \"date-time\"\n    },\n    {\n      \"@id\": \"urn:bookstore:OrderId\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#string\"\n      },\n      \"https://json-tology.dev/vocab#format\": \"uuid\"\n    },\n    {\n      \"@id\": \"urn:bookstore:PageCount\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#integer\"\n      },\n      \"http://www.w3.org/2002/07/owl#withRestrictions\": {\n        \"@list\": [\n          {\n            \"http://www.w3.org/2001/XMLSchema#minInclusive\": 0\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:PageNumber\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#integer\"\n      },\n      \"http://www.w3.org/2002/07/owl#withRestrictions\": {\n        \"@list\": [\n          {\n            \"http://www.w3.org/2001/XMLSchema#minInclusive\": 1\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:PageSize\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#integer\"\n      },\n      \"http://www.w3.org/2002/07/owl#withRestrictions\": {\n        \"@list\": [\n          {\n            \"http://www.w3.org/2001/XMLSchema#minInclusive\": 1\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:PersonName\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#string\"\n      },\n      \"http://www.w3.org/2002/07/owl#withRestrictions\": {\n        \"@list\": [\n          {\n            \"http://www.w3.org/2001/XMLSchema#maxLength\": 200\n          },\n          {\n            \"http://www.w3.org/2001/XMLSchema#minLength\": 1\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:PostalCode\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\n      \"http://www.w3.org/2002/07/owl#onDatatype\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#string\"\n      },\n      \"http://www.w3.org/2002/07/owl#withRestrictions\": {\n        \"@list\": [\n          {\n            \"http://www.w3.org/2001/XMLSchema#maxLength\": 12\n          },\n          {\n            \"http://www.w3.org/2001/XMLSchema#minLength\": 3\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:PrintPageCount\",\n      \"@type\": \"http://www.w3.org/2000/01/rdf-schema#Datatype\",\
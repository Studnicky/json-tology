    }\n    },\n    {\n      \"@id\": \"urn:bookstore:AuthorName\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#comment\": \"A person’s name in the book-authorship context. Validation is owned by PersonName; this is a domain-specific brand.\",\n      \"http://www.w3.org/2002/07/owl#equivalentClass\": {\n        \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n        \"http://www.w3.org/2002/07/owl#unionOf\": {\n          \"@list\": [\n            {\n              \"@id\": \"urn:bookstore:PersonName\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:CustomerName\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#comment\": \"A person’s name in the customer-identity context. Validation is owned by PersonName; this is a domain-specific brand.\",\n      \"http://www.w3.org/2002/07/owl#equivalentClass\": {\n        \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n        \"http://www.w3.org/2002/07/owl#unionOf\": {\n          \"@list\": [\n            {\n              \"@id\": \"urn:bookstore:PersonName\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Money\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#subClassOf\": [\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"https://bookstore.example/amount\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"https://bookstore.example/currency\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        }\n      ]\n    },\n    {\n      \"@id\": \"https://bookstore.example/amount\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Money\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:Amount\"\n      }\n    },\n    {\n      \"@id\": \"https://bookstore.example/currency\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Money\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:CurrencyCode\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Address\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#subClassOf\": [\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"https://bookstore.example/street\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"https://bookstore.example/city\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"https://bookstore.example/postalCode\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        }\n      ]\n    },\n    {\n      \"@id\": \"https://bookstore.example/city\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Addres
"{\n  \"@context\": {\n    \"dash\": \"http://datashapes.org/dash#\",\n    \"dcat\": \"http://www.w3.org/ns/dcat#\",\n    \"dct\": \"http://purl.org/dc/terms/\",\n    \"dcterms\": \"http://purl.org/dc/terms/\",\n    \"foaf\": \"http://xmlns.com/foaf/0.1/\",\n    \"jt\": \"https://json-tology.dev/vocab#\",\n    \"owl\": \"http://www.w3.org/2002/07/owl#\",\n    \"prov\": \"http://www.w3.org/ns/prov#\",\n    \"rdf\": \"http://www.w3.org/1999/02/22-rdf-syntax-ns#\",\n    \"rdfs\": \"http://www.w3.org/2000/01/rdf-schema#\",\n    \"schema\": \"http://schema.org/\",\n    \"sh\": \"http://www.w3.org/ns/shacl#\",\n    \"skos\": \"http://www.w3.org/2004/02/skos/core#\",\n    \"vann\": \"http://purl.org/vocab/vann/\",\n    \"xsd\": \"http://www.w3.org/2001/XMLSchema#\"\n  },\n  \"@graph\": [\n    {\n      \"@id\": \"urn:bookstore:Amount\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:CityName\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:CountryCode\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:CurrencyCode\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2002/07/owl#oneOf\": {\n        \"@list\": [\n          {\n            \"@type\": \"xsd:string\",\n            \"@value\": \"USD\"\n          },\n          {\n            \"@type\": \"xsd:string\",\n            \"@value\": \"EUR\"\n          },\n          {\n            \"@type\": \"xsd:string\",\n            \"@value\": \"GBP\"\n          },\n          {\n            \"@type\": \"xsd:string\",\n            \"@value\": \"JPY\"\n          },\n          {\n            \"@type\": \"xsd:string\",\n            \"@value\": \"CAD\"\n          },\n          {\n            \"@type\": \"xsd:string\",\n            \"@value\": \"AUD\"\n          }\n        ]\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:CustomerId\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:Email\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:Isbn\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:Iso8601\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:OrderId\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:PersonName\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:PostalCode\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:Quantity\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:RatingScore\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:ReviewId\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:StreetLine\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:Title\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\"\n    },\n    {\n      \"@id\": \"urn:bookstore:AuthorName\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#comment\": \"A person’s name in the book-authorship context. Validation is owned by PersonName; this is a domain-specific brand.\",\n      \"http://www.w3.org/2002/07/owl#equivalentClass\": {\n        \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n        \"http://www.w3.org/2002/07/owl#unionOf\": {\n          \"@list\": [\n            {\n              \"@id\": \"urn:bookstore:PersonName\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:CustomerName\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#comment\": \"A person’s name in the customer-identity context. Validation is owned by PersonName; this is a domain-specific brand.\",\n      \"http://www.w3.org/2002/07/owl#equivalentClass\": {\n        \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n        \"http://www.w3.org/2002/07/owl#unionOf\": {\n          \"@list\": [\n            {\n              \"@id\": \"urn:bookstore:PersonName\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Money\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#subClassOf\": [\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Money#amount\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Money#currency\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        }\n      ]\n    },\n    {\n      \"@id\": \"urn:bookstore:Money#amount\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Money\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:Amount\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Money#currency\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Money\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:CurrencyCode\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Address\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#subClassOf\": [\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Address#street\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Address#city\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Address#postalCode\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        }\n      ]\n    },\n    {\n      \"@id\": \"urn:bookstore:Address#city\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Address\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:CityName\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Address#country\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Address\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:CountryCode\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Address#postalCode\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Address\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:PostalCode\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Address#street\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Address\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:StreetLine\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Book\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#subClassOf\": [\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Book#isbn\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Book#title\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Book#authors\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Book#price\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Book#authors\"\n          },\n          \"http://www.w3.org/2002/07/owl#allValuesFrom\": {\n            \"@id\": \"urn:bookstore:AuthorName\"\n          }\n        }\n      ]\n    },\n    {\n      \"@id\": \"urn:bookstore:Book#authors\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Book\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"http://www.w3.org/1999/02/22-rdf-syntax-ns#List\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Book#inStock\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#DatatypeProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Book\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"http://www.w3.org/2001/XMLSchema#boolean\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Book#isbn\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Book\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:Isbn\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Book#price\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Book\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:Money\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Book#title\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Book\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:Title\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Customer\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#subClassOf\": [\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Customer#id\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Customer#email\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Customer#name\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:Customer#addresses\"\n          },\n          \"http://www.w3.org/2002/07/owl#allValuesFrom\": {\n            \"@id\": \"urn:bookstore:Address\"\n          }\n        }\n      ]\n    },\n    {\n      \"@id\": \"urn:bookstore:Customer#addresses\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Customer\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"http://www.w3.org/1999/02/22-rdf-syntax-ns#List\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Customer#email\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Customer\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:Email\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Customer#id\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Customer\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:CustomerId\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:Customer#name\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rdf-schema#domain\": {\n        \"@id\": \"urn:bookstore:Customer\"\n      },\n      \"http://www.w3.org/2000/01/rdf-schema#range\": {\n        \"@id\": \"urn:bookstore:CustomerName\"\n      }\n    },\n    {\n      \"@id\": \"urn:bookstore:OrderLine\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#Class\",\n      \"http://www.w3.org/2000/01/rdf-schema#subClassOf\": [\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:OrderLine#bookIsbn\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:OrderLine#quantity\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        },\n        {\n          \"@type\": \"http://www.w3.org/2002/07/owl#Restriction\",\n          \"http://www.w3.org/2002/07/owl#onProperty\": {\n            \"@id\": \"urn:bookstore:OrderLine#unitPrice\"\n          },\n          \"http://www.w3.org/2002/07/owl#minCardinality\": 1\n        }\n      ]\n    },\n    {\n      \"@id\": \"urn:bookstore:OrderLine#bookIsbn\",\n      \"@type\": \"http://www.w3.org/2002/07/owl#ObjectProperty\",\n      \"http://www.w3.org/2000/01/rd
{
  "urn:bookstore:Amount": {
    "$id": "urn:bookstore:Amount",
    "minimum": 0,
    "type": "number"
  },
  "urn:bookstore:CityName": {
    "$id": "urn:bookstore:CityName",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
  },
  "urn:bookstore:CountryCode": {
    "$id": "urn:bookstore:CountryCode",
    "pattern": "^[A-Z]{2}$",
    "type": "string"
  },
  "urn:bookstore:CurrencyCode": {
    "$id": "urn:bookstore:CurrencyCode",
    "enum": [
      "USD",
      "EUR",
      "GBP",
      "JPY",
      "CAD",
      "AUD"
    ],
    "type": "string"
  },
  "urn:bookstore:CustomerId": {
    "$id": "urn:bookstore:CustomerId",
    "format": "uuid",
    "type": "string"
  },
  "urn:bookstore:Email": {
    "$id": "urn:bookstore:Email",
    "format": "email",
    "type": "string"
  },
  "urn:bookstore:Isbn": {
    "$id": "urn:bookstore:Isbn",
    "pattern": "^\\d{13}$",
    "type": "string"
  },
  "urn:bookstore:Iso8601": {
    "$id": "urn:bookstore:Iso8601",
    "format": "date-time",
    "type": "string"
  },
  "urn:bookstore:OrderId": {
    "$id": "urn:bookstore:OrderId",
    "format": "uuid",
    "type": "string"
  },
  "urn:bookstore:PersonName": {
    "$id": "urn:bookstore:PersonName",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
  },
  "urn:bookstore:PostalCode": {
    "$id": "urn:bookstore:PostalCode",
    "maxLength": 12,
    "minLength": 3,
    "type": "string"
  },
  "urn:bookstore:PrintStatus": {
    "$id": "urn:bookstore:PrintStatus",
    "enum": [
      "inPrint",
      "outOfPrint",
      "limitedRun"
    ],
    "type": "string"
  },
  "urn:bookstore:PublicationDate": {
    "$id": "urn:bookstore:PublicationDate",
    "format": "date",
    "type": "string"
  },
  "urn:bookstore:Quantity": {
    "$id": "urn:bookstore:Quantity",
    "format": "int32",
    "minimum": 1,
    "type": "integer"
  },
  "urn:bookstore:RatingScore": {
    "$id": "urn:bookstore:RatingScore",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
  },
  "urn:bookstore:ReviewId": {
    "$id": "urn:bookstore:ReviewId",
    "format": "uuid",
    "type": "string"
  },
  "urn:bookstore:StockLevel": {
    "$id": "urn:bookstore:StockLevel",
    "maximum": 100,
    "minimum": 0,
    "multipleOf": 5,
    "type": "integer"
  },
  "urn:bookstore:StreetLine": {
    "$id": "urn:bookstore:StreetLine",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
  },
  "urn:bookstore:Title": {
    "$id": "urn:bookstore:Title",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
  },
  "urn:bookstore:AuthorName": {
    "$id": "urn:bookstore:AuthorName",
    "$ref": "urn:bookstore:PersonName",
    "description": "A person’s name in the book-authorship context. Validation is owned by PersonName; this is a domain-specific brand."
  },
  "urn:bookstore:CustomerName": {
    "$id": "urn:bookstore:CustomerName",
    "$ref": "urn:bookstore:PersonName",
    "description": "A person’s name in the customer-identity context. Validation is owned by PersonName; this is a domain-specific brand."
  },
  "urn:bookstore:Money": {
    "$id": "urn:bookstore:Money",
    "properties": {
      "amount": {
        "$ref": "urn:bookstore:Amount"
      },
      "currency": {
        "$ref": "urn:bookstore:CurrencyCode"
      }
    },
    "required": [
      "amount",
      "currency"
    ],
    "type": "object"
  },
  "urn:bookstore:Address": {
    "$id": "urn:bookstore:Address",
    "properties": {
      "city": {
        "$ref": "urn:bookstore:CityName"
      },
      "country": {
        "$ref": "urn:bookstore:CountryCode"
      },
      "postalCode": {
        "$ref": "urn:bookstore:PostalCode"
      },
      "street": {
        "$ref": "urn:bookstore:StreetLine"
      }
    },
    "required": [
      "street",
      "city",
      "postalCode"
    ],
    "type": "object"
  },
  "urn:bookstore:BookAnnotations": {
    "$id": "urn:bookstore:BookAnnotations",
    "patternProperties": {
      "^note_": {
        "type": "string"
      },
      "^tag_": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "urn:bookstore:BookCatalogEntry": {
    "$defs": {
      "Variant": {
        "$id": "urn:bookstore:BookCatalogEntryVariant",
        "properties": {
          "kind": {
            "enum": [
              "hardcover",
              "paperback",
              "ebook"
            ],
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "price"
        ],
        "type": "object"
      }
    },
    "$id": "urn:bookstore:BookCatalogEntry",
    "properties": {
      "isbn": {
        "$ref": "urn:bookstore:Isbn"
      },
      "variants": {
        "items": {
          "$ref": "urn:bookstore:BookCatalogEntryVariant"
        },
        "type": "array"
      }
    },
    "required": [
      "isbn",
      "variants"
    ],
    "type": "object"
  },
  "urn:bookstore:BookRatingHistogram": {
    "$id": "urn:bookstore:BookRatingHistogram",
    "description": "Five-element histogram of star-rating counts: [1-star, 2-star, 3-star, 4-star, 5-star]",
    "prefixItems": [
      {
        "description": "1-star count",
        "minimum": 0,
        "type": "integer"
      },
      {
        "description": "2-star count",
        "minimum": 0,
        "type": "integer"
      },
      {
        "description": "3-star count",
        "minimum": 0,
        "type": "integer"
      },
      {
        "description": "4-star count",
        "minimum": 0,
        "type": "integer"
      },
      {
        "description": "5-star count",
        "minimum": 0,
        "type": "integer"
      }
    ],
    "type": "array",
    "uniqueItems": true
  },
  "urn:bookstore:Book": {
    "$id": "urn:bookstore:Book",
    "properties": {
      "annotations": {
        "$ref": "urn:bookstore:BookAnnotations"
      },
      "authors": {
        "items": {
          "$ref": "urn:bookstore:AuthorName"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "inStock": {
        "default": true,
        "type": "boolean"
      },
      "isbn": {
        "$ref": "urn:bookstore:Isbn"
      },
      "price": {
        "$ref": "urn:bookstore:Money"
      },
      "printStatus": {
        "$ref": "urn:bookstore:PrintStatus"
      },
      "publishedOn": {
        "$ref": "urn:bookstore:PublicationDate"
      },
      "ratings": {
        "$ref": "urn:bookstore:BookRatingHistogram"
      },
      "stockLevel": {
        "$ref": "urn:bookstore:StockLevel"
      },
      "title": {
        "$ref": "urn:bookstore:Title"
      }
    },
    "required": [
      "isbn",
      "title",
      "authors",
      "price",
      "printStatus"
    ],
    "type": "object"
  },
  "urn:bookstore:Customer": {
    "$id": "urn:bookstore:Customer",
    "properties": {
      "addresses": {
        "default": [],
        "items": {
          "$ref": "urn:bookstore:Address"
        },
        "type": "array"
      },
      "email": {
        "$ref": "urn:bookstore:Email"
      },
      "id": {
        "$ref": "urn:bookstore:CustomerId",
        "inverseFunctional": true
      },
      "name": {
        "$ref": "urn:bookstore:CustomerName"
      }
    },
    "required": [
      "id",
      "email",
      "name"
    ],
    "type": "object"
  },
  "urn:bookstore:OrderLine": {
    "$id": "urn:bookstore:OrderLine",
    "properties": {
      "bookIsbn": {
        "$ref": "urn:bookstore:Isbn"
      },
      "quantity": {
        "$ref": "urn:bookstore:Quantity"
      },
      "unitPrice": {
        "$ref": "urn:bookstore:Money"
      }
    },
    "required": [
      "bookIsbn",
      "quantity",
      "unitPrice"
    ],
    "type": "object"
  },
  "urn:bookstore:Order": {
    "$id": "urn:bookstore:Order",
    "properties": {
      "customerId": {
        "$ref": "urn:bookstore:CustomerId"
      },
      "id": {
        "$ref": "urn:bookstore:OrderId"
      },
      "items": {
        "items": {
          "$ref": "urn:bookstore:OrderLine"
        },
        "minItems": 1,
        "type": "array"
      },
      "placedAt": {
        "$ref": "urn:bookstore:Iso8601",
        "irreflexive": true,
        "transitive": true
      },
      "shippingAddress": {
        "$ref": "urn:bookstore:Address"
      },
      "total": {
        "$ref": "urn:bookstore:Money"
      }
    },
    "required": [
      "id",
      "customerId",
      "items",
      "total",
      "placedAt",
      "shippingAddress"
    ],
    "type": "object"
  },
  "urn:bookstore:Review": {
    "$id": "urn:bookstore:Review",
    "properties": {
      "body": {
        "minLength": 10,
        "type": "string"
      },
      "bookIsbn": {
        "$ref": "urn:bookstore:Isbn"
      },
      "customerId": {
        "$ref": "urn:bookstore:CustomerId",
        "functional": true
      },
      "id": {
        "$ref": "urn:bookstore:ReviewId"
      },
      "postedAt": {
        "$ref": "urn:bookstore:Iso8601"
      },
      "rating": {
        "$ref": "urn:bookstore:RatingScore"
      }
    },
    "required": [
      "id",
      "bookIsbn",
      "customerId",
      "rating",
      "body",
      "postedAt"
    ],
    "type": "object"
  },
  "urn:bookstore:BookListPage": {
    "$id": "urn:bookstore:BookListPage",
    "description": "A page of results with pagination metadata",
    "properties": {
      "hasNext": {
        "type": "boolean"
      },
      "hasPrev": {
        "type": "boolean"
      },
      "items": {
        "items": {
          "$id": "urn:bookstore:Book",
          "properties": {
            "annotations": {
              "$ref": "urn:bookstore:BookAnnotations"
            },
            "authors": {
              "items": {
                "$ref": "urn:bookstore:AuthorName"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "inStock": {
              "default": true,
              "type": "boolean"
            },
            "isbn": {
              "$ref": "urn:bookstore:Isbn"
            },
            "price": {
              "$ref": "urn:bookstore:Money"
            },
            "printStatus": {
              "$ref": "urn:bookstore:PrintStatus"
            },
            "publishedOn": {
              "$ref": "urn:bookstore:PublicationDate"
            },
            "ratings": {
              "$ref": "urn:bookstore:BookRatingHistogram"
            },
            "stockLevel": {
              "$ref": "urn:bookstore:StockLevel"
            },
            "title": {
              "$ref": "urn:bookstore:Title"
            }
          },
          "required": [
            "isbn",
            "title",
            "authors",
            "price",
            "printStatus"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "nextCursor": {
        "type": "string"
      },
      "page": {
        "minimum": 1,
        "type": "number"
      },
      "pageSize": {
        "minimum": 1,
        "type": "number"
      },
      "prevCursor": {
        "type": "string"
      },
      "total": {
        "minimum": 0,
        "type": "number"
      },
      "totalPages": {
        "minimum": 0,
        "type": "number"
      }
    },
    "required": [
      "items",
      "total",
      "page",
      "pageSize"
    ],
    "type": "object"
  },
  "urn:bookstore:EBook": {
    "$id": "urn:bookstore:EBook",
    "allOf": [
      {
        "$ref": "urn:bookstore:Book"
      },
      {
        "else": {
          "properties": {
            "pdfVersion": {
              "type": "string"
            }
          },
          "required": [
            "pdfVersion"
          ],
          "type": "object"
        },
        "if": {
          "properties": {
            "fileFormat": {
              "const": "epub"
            }
          },
          "required": [
            "fileFormat"
          ],
          "type": "object"
        },
        "properties": {
          "downloadUrl": {
            "format": "uri",
            "type": "string"
          },
          "fileFormat": {
            "enum": [
              "epub",
              "pdf",
              "mobi"
            ],
            "type": "string"
          },
          "fileSizeBytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "fileFormat",
          "downloadUrl"
        ],
        "then": {
          "properties": {
            "epubVersion": {
              "type": "string"
            }
          },
          "required": [
            "epubVersion"
          ],
          "type": "object"
        },
        "type": "object"
      }
    ]
  },
  "urn:bookstore:PrintBook": {
    "$id": "urn:bookstore:PrintBook",
    "disjointWith": "urn:bookstore:EBook",
    "allOf": [
      {
        "$ref": "urn:bookstore:Book"
      },
      {
        "properties": {
          "binding": {
            "enum": [
              "hardcover",
              "paperback"
            ],
            "type": "string"
          },
          "pageCount": {
            "minimum": 1,
            "type": "integer"
          },
          "weightGrams": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "binding",
          "pageCount"
        ],
        "type": "object"
      }
    ]
  },
  "urn:bookstore:RareBook": {
    "$id": "urn:bookstore:RareBook",
    "allOf": [
      {
        "$ref": "urn:bookstore:PrintBook"
      },
      {
        "properties": {
          "estimatedAgeYears": {
            "minimum": 0,
            "type": "integer"
          },
          "firstEditionYear": {
            "maximum": 2100,
            "minimum": 1450,
            "type": "integer"
          }
        },
        "required": [
          "firstEditionYear"
        ],
        "type": "object"
      }
    ],
    "jt:restrictions": [
      {
        "kind": "someValuesFrom",
        "onProperty": "urn:bookstore:Book#authors",
        "value": "urn:bookstore:AuthorName"
      },
      {
        "kind": "maxCardinality",
        "onProperty": "urn:bookstore:Book#authors",
        "value": 1
      }
    ]
  },
  "urn:bookstore:InPrintBook": {
    "$id": "urn:bookstore:InPrintBook",
    "allOf": [
      {
        "$ref": "urn:bookstore:Book"
      },
      {
        "type": "object"
      }
    ],
    "jt:restrictions": [
      {
        "kind": "hasValue",
        "onProperty": "urn:bookstore:Book#printStatus",
        "value": "inPrint"
      }
    ]
  },
  "urn:bookstore:OutOfPrintBook": {
    "$id": "urn:bookstore:OutOfPrintBook",
    "not": {
      "$ref": "urn:bookstore:InPrintBook"
    },
    "allOf": [
      {
        "$ref": "urn:bookstore:Book"
      }
    ],
    "type": "object"
  },
  "urn:bookstore:SignedFirstEdition": {
    "$id": "urn:bookstore:SignedFirstEdition",
    "allOf": [
      {
        "$ref": "urn:bookstore:RareBook"
      },
      {
        "properties": {
          "provenance": {
            "minLength": 1,
            "type": "string"
          },
          "signedBy": {
            "$ref": "urn:bookstore:AuthorName"
          }
        },
        "required": [
          "signedBy"
        ],
        "type": "object"
      }
    ]
  },
  "urn:bookstore:SimilarBook": {
    "$id": "urn:bookstore:SimilarBook",
    "properties": {
      "a": {
        "$ref": "urn:bookstore:Book"
      },
      "b": {
        "$ref": "urn:bookstore:Book",
        "reflexive": true,
        "symmetric": true
      }
    },
    "required": [
      "a",
      "b"
    ],
    "type": "object"
  },
  "urn:bookstore:Sequel": {
    "$id": "urn:bookstore:Sequel",
    "properties": {
      "book": {
        "$ref": "urn:bookstore:Book"
      },
      "predecessor": {
        "$ref": "urn:bookstore:Book",
        "asymmetric": true
      }
    },
    "required": [
      "book",
      "predecessor"
    ],
    "type": "object"
  }
}
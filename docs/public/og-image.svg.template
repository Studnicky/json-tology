<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" role="img" aria-label="json-tology — TypeScript types, runtime validation, and OWL ontology output">

  <defs>
    <linearGradient id="bgGradient" x1="0" y1="0" x2="1200" y2="630" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#0E2A2E"/>
      <stop offset="0.5" stop-color="#0A2024"/>
      <stop offset="1" stop-color="#08171A"/>
    </linearGradient>

    <linearGradient id="hexJst" x1="92" y1="36" x2="308" y2="364" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#7FE7D8"/>
      <stop offset="0.5" stop-color="#24A5B5"/>
      <stop offset="1" stop-color="#08717A"/>
    </linearGradient>

    <linearGradient id="hexBlue" x1="86" y1="32" x2="314" y2="368" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#58A9E6"/>
      <stop offset="0.48" stop-color="#317FC4"/>
      <stop offset="1" stop-color="#3178C6"/>
    </linearGradient>

    <linearGradient id="hexGrey" x1="86" y1="32" x2="314" y2="368" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#F7F7F7"/>
      <stop offset="0.52" stop-color="#D9DEE3"/>
      <stop offset="1" stop-color="#8A929A"/>
    </linearGradient>

    <linearGradient id="hexGreen" x1="86" y1="32" x2="314" y2="368" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#5BC371"/>
      <stop offset="0.5" stop-color="#34A04F"/>
      <stop offset="1" stop-color="#1E7B36"/>
    </linearGradient>

    <linearGradient id="hexAmber" x1="86" y1="32" x2="314" y2="368" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#F4C97A"/>
      <stop offset="0.5" stop-color="#C9892B"/>
      <stop offset="1" stop-color="#8C5A14"/>
    </linearGradient>

    <linearGradient id="hexPurple" x1="86" y1="32" x2="314" y2="368" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#B393F0"/>
      <stop offset="0.5" stop-color="#7E5BC4"/>
      <stop offset="1" stop-color="#5436A4"/>
    </linearGradient>

    <linearGradient id="hexRose" x1="86" y1="32" x2="314" y2="368" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#F0A2A2"/>
      <stop offset="0.5" stop-color="#D45C5C"/>
      <stop offset="1" stop-color="#9C3030"/>
    </linearGradient>

    <filter id="nodeShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="14" stdDeviation="16" flood-color="#000000" flood-opacity="0.45"/>
    </filter>

    <symbol id="hexCell" viewBox="0 0 400 400" overflow="visible">
      <path d="M200 24 L352.4 112 L352.4 288 L200 376 L47.6 288 L47.6 112 Z"/>
      <path d="M200 24 L47.6 112 L112 149 L200 98 Z" fill="#FFFFFF" opacity="0.16"/>
      <path d="M200 24 L352.4 112 L288 149 L200 98 Z" fill="#FFFFFF" opacity="0.08"/>
      <path d="M47.6 112 L112 149 L200 376 L47.6 288 Z" fill="#000000" opacity="0.14"/>
      <path d="M352.4 112 L288 149 L200 376 L352.4 288 Z" fill="#000000" opacity="0.20"/>
      <path d="M200 24 L352.4 112 L352.4 288 L200 376 L47.6 288 L47.6 112 Z" fill="none" stroke="#FFFFFF" stroke-width="6" opacity="0.45"/>
    </symbol>
  </defs>

  <rect x="0" y="0" width="1200" height="630" fill="url(#bgGradient)"/>

  <!--
    Seven-cluster hex motif mirrors the sidebar HexRing on the docs site.
    Center hex carries the JST wordmark; the six outer hexes ring the
    technologies json-tology bridges (TypeScript, JSON Schema, RDF, W3C,
    Validation, Node.js). Coordinates derived from HexRing.vue's offsets
    at scale 0.4 (hex W ~122 / H ~141 / vertical-step 106), cluster
    centered at (260, 315).
  -->
  <g filter="url(#nodeShadow)">
    <g transform="translate(199, 244.5) scale(0.305)"><use href="#hexCell" fill="url(#hexJst)"/></g>
    <g transform="translate(321, 244.5) scale(0.305)"><use href="#hexCell" fill="url(#hexBlue)"/></g>
    <g transform="translate(260, 350.5) scale(0.305)"><use href="#hexCell" fill="url(#hexAmber)"/></g>
    <g transform="translate(138, 350.5) scale(0.305)"><use href="#hexCell" fill="url(#hexGreen)"/></g>
    <g transform="translate(77, 244.5) scale(0.305)"><use href="#hexCell" fill="url(#hexRose)"/></g>
    <g transform="translate(138, 138.5) scale(0.305)"><use href="#hexCell" fill="url(#hexGrey)"/></g>
    <g transform="translate(260, 138.5) scale(0.305)"><use href="#hexCell" fill="url(#hexPurple)"/></g>
  </g>

  <!-- Hex labels (centered on each hex midpoint at y_center + 6 baseline shift). -->
  <g font-family="Arial, Helvetica, sans-serif" font-weight="700" text-anchor="middle" fill="#FFFFFF">
    <text x="260" y="328" font-size="36" letter-spacing="-2">JST</text>
    <text x="382" y="324" font-size="22" letter-spacing="-1">TS</text>
    <text x="321" y="430" font-size="18" letter-spacing="-0.5">JSON</text>
    <text x="199" y="430" font-size="20" letter-spacing="-0.5">VAL</text>
    <text x="77" y="324" font-size="22" letter-spacing="-0.5">RDF</text>
    <text x="138" y="218" font-size="22" letter-spacing="-0.5">W3C</text>
    <text x="321" y="218" font-size="18" letter-spacing="-0.5">NODE</text>
  </g>

  <!-- Wordmark + tagline + version pill -->
  <g transform="translate(560, 220)">
    <text x="0" y="0" font-family="Arial, Helvetica, sans-serif" font-size="84" font-weight="800" letter-spacing="-2.1" fill="#DDFBFF">json-tology</text>
    <text x="0" y="62" font-family="Arial, Helvetica, sans-serif" font-size="30" font-weight="500" fill="#7FE7D8" opacity="0.85">One source of truth.</text>
    <text x="0" y="100" font-family="Arial, Helvetica, sans-serif" font-size="30" font-weight="500" fill="#7FE7D8" opacity="0.85">TypeScript types · validation · OWL ontology.</text>
    <text x="0" y="180" font-family="'SF Mono', Menlo, Consolas, monospace" font-size="22" font-weight="500" fill="#BDF6F2" opacity="0.6">Author in JSON Schema. Reason over the graph.</text>

    <!-- Version pill -->
    <g transform="translate(0, 220)">
      <rect x="0" y="0" rx="22" ry="22" width="170" height="44" fill="#08717A" stroke="#7FE7D8" stroke-width="1.5"/>
      <text x="85" y="30" font-family="'SF Mono', Menlo, Consolas, monospace" font-size="20" font-weight="700" fill="#DDFBFF" text-anchor="middle" letter-spacing="0.5">v{{VERSION}}</text>
    </g>
  </g>
</svg>
